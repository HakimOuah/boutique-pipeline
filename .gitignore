__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.venv/
.env
/tmp/venv/
/data/*.sqlite3
/data/*.sqlite3-*
/data/inbox/*
!/data/inbox/.gitkeep
/reports/*
!/reports/.gitkeep

# verrou transitoire du régime synchrone (ordres/traiter-inbox.sh)
/ordres/.lock
# verrou transitoire de l'exécutant Codex images (ordres/generer-images.sh)
/ordres/.lock-codex

/ordres/journal/*
!/ordres/journal/.gitkeep

# Artefacts locaux du serveur MCP Playwright (sorties/captures) — jamais dans git
.playwright-mcp/

# Artefacts temporaires locaux de contrôle/rendu Codex
/.tmp/
**/verification-import/

# Inspection exhaustive temporaire generee a cote d'un XLSX par artifact-tool
*.xlsx.inspect.ndjson

# Dump Shopify brut (régénérable via dump_products.py)
/catalogues/*/shopify/shopify-products-dump.jsonl
/catalogues/*/shopify/variants-fix-state.json
/catalogues/*/shopify/variants-fix-rapport.json

# Photos fournisseur AliExpress (lourdes) — jamais dans git
/boutique-seiko-mod/sources-fournisseur-2026-08/
/catalogues/*/sources-fournisseur/
/catalogues/*/sources-par-handle/
/catalogues/*/livraisons-visuels-codex/

# Brouillons de travail des agents — jamais dans git
/boutique-seiko-mod/scratchpad/

# Bruts TrendTrack (crédits API, parfois clés dans le contexte) — jamais dans git
analyses/_tt_raw_*.json

# Cache local du script de découverte DataForSEO (régénérable, coûte 0 à refaire)
/scripts/.cache_kw_dfs/
.env.bak*
.env.local

# Worktrees d'agents — jamais versionnés
.worktrees/
