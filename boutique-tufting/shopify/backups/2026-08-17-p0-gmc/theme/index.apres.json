              "type": "text",
              "settings": {
                "show_on_display": "desktop_and_mobile",
                "text": "<p>Les réponses aux questions qu'on nous pose le plus avant une première commande. Il en manque une ? Écris-nous, on répond avant l'achat.</p>",
                "text_style": "paragraph",
                "paragraph_font_size": "normal",
                "font_weight": 400,
                "alignment": "left",
                "alignment_mobile": "left",
                "show_read_more": false,
