              "blocks": {
                "q1": {
                  "type": "_accordion",
                  "settings": {
                    "show_on_display": "desktop_and_mobile",
                    "heading": "C'est difficile d'apprendre le tufting ?",
                    "heading_tag": "p",
                    "heading_style": "paragraph",
                    "open_by_default": false,
                    "icon": "none",
                    "icon_custom": "",
                    "additional_class": ""
                  },
                  "blocks": {
                    "t": {
                      "type": "text",
                      "settings": {
                        "show_on_display": "desktop_and_mobile",
                        "text": "<p>Ça s'apprend — et c'est exactement pour ça qu'on existe. Avec le bon matériel et nos guides pas à pas, ta première pièce est à ta portée : la communauté compte une demi-journée à une journée pour un premier tapis simple.</p>",
                        "text_style": "paragraph",
                        "paragraph_font_size": "normal",
                        "font_weight": 400,
                        "alignment": "left",
                        "alignment_mobile": "left",
                        "show_read_more": false,
