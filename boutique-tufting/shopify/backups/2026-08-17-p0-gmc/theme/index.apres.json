    "avis_clients": {
      "type": "bv-avis-clients",
      "blocks": {
        "r1": {
          "type": "review",
          "settings": {
            "rating": 5,
            "verified": true,
            "title": "Mon premier tapis, enfin accroché !",
            "text": "Kit reçu en quatre jours. Le guide de démarrage français change tout : j'ai suivi les vidéos pas à pas et mon premier tapis — un soleil pour la chambre de ma fille — est au mur. Très fière de moi.",
            "author": "Camille R.",
            "date_text": "Il y a 3 jours"
          }
        },
        "r2": {
          "type": "review",
          "settings": {
            "rating": 5,
            "verified": true,
            "title": "Parfait pour débuter sans se tromper",
            "text": "J'avais peur d'acheter du matériel incompatible. Là, tout fonctionne ensemble : gun, toile, fils. La prise en main est plus simple que je pensais, et le service client m'a répondu en français dans la journée.",
            "author": "Léa M.",
            "date_text": "Il y a 1 semaine"
          }
        },
        "r3": {
          "type": "review",
          "settings": {
            "rating": 4,
            "verified": true,
            "title": "Très bon kit, prévois ton cadre",
            "text": "Rien à redire sur la machine et la tondeuse. Pense juste à préparer ton cadre avant la livraison — le guide explique comment le fabriquer. Il ne manque qu'un choix de coloris de fils plus large dans le kit.",
            "author": "Sarah D.",
            "date_text": "Il y a 2 semaines"
          }
        }
      },
