                  "block_order": [
                    "t"
                  ]
                },
                "q2": {
                  "type": "_accordion",
                  "settings": {
                    "show_on_display": "desktop_and_mobile",
                    "heading": "Qu'est-ce qu'il y a dans le kit ?",
                    "heading_tag": "p",
                    "heading_style": "paragraph",
                    "open_by_default": false,
                    "icon": "none",
                    "icon_custom": "",
                    "additional_class": ""
                  },
                  "blocks": {
                    "t": {
                      "type": "text",
                      "settings": {
                        "show_on_display": "desktop_and_mobile",
                        "text": "<p>Tout ce qu'il faut pour ta première pièce, tondeuse comprise : gun 2-en-1, tondeuse avec guide de tonte, toile, pelotes de fil et petit outillage. Le détail exact est affiché sur la fiche du kit.</p>",
                        "text_style": "paragraph",
                        "paragraph_font_size": "normal",
                        "font_weight": 400,
                        "alignment": "left",
                        "alignment_mobile": "left",
                        "show_read_more": false,
                        "read_more_length": 50,
                        "read_more_text": "Voir plus",
                        "read_less_text": "Voir moins",
                        "truncate": false,
                        "truncate_length": 2,
                        "margin_top": 0,
                        "margin_bottom": 0,
                        "additional_class": ""
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
