                  ]
                },
                "q3": {
                  "type": "_accordion",
                  "settings": {
                    "show_on_display": "desktop_and_mobile",
                    "heading": "Il me faut quoi en plus ?",
                    "heading_tag": "p",
                    "heading_style": "paragraph",
                    "open_by_default": false,
                    "icon": "none",
                    "icon_custom": "",
                    "additional_class": ""
                  },
                  "blocks": {
                    "t": {
                      "type": "text",
                      "settings": {
                        "show_on_display": "desktop_and_mobile",
                        "text": "<p>Un cadre pour tendre ta toile — notre guide t'explique comment le fabriquer ou où l'acheter près de chez toi — et de la colle de finition pour le dos.</p>",
                        "text_style": "paragraph",
                        "paragraph_font_size": "normal",
                        "font_weight": 400,
                        "alignment": "left",
                        "alignment_mobile": "left",
                        "show_read_more": false,
                        "read_more_length": 50,
                        "read_more_text": "Voir plus",
                        "read_less_text": "Voir moins",
                        "truncate": false,
                        "truncate_length": 2,
                        "margin_top": 0,
                        "margin_bottom": 0,
                        "additional_class": ""
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "t"
                  ]
                },
                "q4": {
                  "type": "_accordion",
                  "settings": {
                    "show_on_display": "desktop_and_mobile",
                    "heading": "Vous livrez en combien de temps ?",
                    "heading_tag": "p",
                    "heading_style": "paragraph",
                    "open_by_default": false,
                    "icon": "none",
                    "icon_custom": "",
                    "additional_class": ""
                  },
                  "blocks": {
                    "t": {
                      "type": "text",
                      "settings": {
                        "show_on_display": "desktop_and_mobile",
                        "text": "<p>Livraison offerte en France en 6 à 10 jours ouvrés, avec suivi par e-mail.</p>",
                        "text_style": "paragraph",
                        "paragraph_font_size": "normal",
                        "font_weight": 400,
