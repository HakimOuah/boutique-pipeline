{% comment %}
  Tufteo — Section « Avis clients » (avis saisis a la main).

  RENDU NEUTRALISE LE 16/08/2026 — conformite Google Merchant Center.

  Motif : les blocs de cette section etaient renseignes a la main — Camille R., Lea M., Sarah D.
  sur l'accueil ; Manon T., Julie B., Chloe P. sur la fiche kit — et portaient un badge « Verifie ».
  C'est de la preuve sociale fabriquee : motif de refus « misrepresentation » chez Google, et
  contraire a la regle maison « promesses verifiables uniquement ».
  Les vrais avis (169, importes via Trustoo) sont servis par le widget dedie, plus bas sur la fiche.

  Le balisage d'origine est conserve dans :
   - le theme publie « Tufteo theme » (188623847809) ;
   - boutique-pipeline/boutique-tufting/shopify/backups/2026-08-16-purge-faux-avis/

  Pour reactiver : repasser bv_avis_actif a true — et n'alimenter la section QUE par des avis reels.
{% endcomment %}

{%- assign bv_avis_actif = false -%}
{%- if bv_avis_actif -%}{%- endif -%}

{% schema %}
{
  "name": "Avis clients",
  "tag": "section",
  "class": "bv-avis-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "select", "id": "heading_alignment", "label": "Alignement du titre", "options": [ { "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centre" } ], "default": "left" },
    { "type": "range", "id": "cards", "label": "Cartes visibles (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "color", "id": "card_background", "label": "Fond des cartes" },
    { "type": "color", "id": "card_border", "label": "Bordure des cartes" },
    { "type": "color", "id": "title_color", "label": "Couleur des titres" },
    { "type": "color", "id": "text_color", "label": "Couleur du texte" },
    { "type": "color", "id": "stars_color", "label": "Couleur des etoiles" },
    { "type": "color", "id": "background", "label": "Fond de section" },
    { "type": "range", "id": "padding_top", "label": "Marge haut", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Marge bas", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "limit": 20,
      "settings": [
        { "type": "range", "id": "rating", "label": "Note (etoiles)", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "checkbox", "id": "verified", "label": "Badge Verifie", "default": false },
        { "type": "text", "id": "title", "label": "Titre de l'avis" },
        { "type": "textarea", "id": "text", "label": "Texte de l'avis" },
        { "type": "text", "id": "author", "label": "Auteur" },
        { "type": "text", "id": "date_text", "label": "Date (texte libre)" }
      ]
    }
  ]
}
{% endschema %}
