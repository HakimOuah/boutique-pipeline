filters:
  and:
    - 'type == "regle"'
properties:
  id:
    displayName: ID
  titre:
    displayName: Règle
  statut:
    displayName: Statut
  acceptee_par_hakim:
    displayName: Acceptée
  date_revue:
    displayName: À revoir le
views:
  - type: table
    name: Règles actives
    filters:
      and:
        - 'statut != "retiree"'
    order:
      - note.id
      - note.titre
      - note.statut
      - note.acceptee_par_hakim
  - type: table
    name: Retirées
    filters:
      and:
        - 'statut == "retiree"'
    order:
      - note.id
      - note.titre
