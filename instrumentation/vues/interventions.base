filters:
  and:
    - type == "journal"
properties:
  boutique:
    displayName: Boutique
  date:
    displayName: Date
  leviers:
    displayName: Leviers
  nature:
    displayName: Nature
views:
  - type: table
    name: Journal des interventions
    order:
      - date
      - boutique
      - nature
      - leviers
      - file.name
