filters:
  and:
    - 'type == "journal"'
properties:
  note.boutique:
    displayName: Boutique
  note.date:
    displayName: Date
  note.leviers:
    displayName: Leviers
  note.nature:
    displayName: Nature
views:
  - type: table
    name: Journal des interventions
    order:
      - note.date
      - note.boutique
      - note.nature
      - note.leviers
      - file.name
    sort:
      - property: note.date
        direction: DESC
