filters:
  and:
    - 'type == "journal"'
properties:
  boutique:
    displayName: Boutique
  date:
    displayName: Date
  leviers:
    displayName: Leviers
  nature:
    displayName: Nature
views:
  - type: table
    name: Journal des interventions
    order:
      - note.date
      - note.boutique
      - note.nature
      - note.leviers
      - file.name
