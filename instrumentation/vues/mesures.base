filters:
  and:
    - 'type == "mesure"'
properties:
  boutique:
    displayName: Boutique
  periode:
    displayName: Période
  sessions:
    displayName: Sessions
  sessions_payantes:
    displayName: Payantes
  paniers:
    displayName: Paniers
  checkouts_atteints:
    displayName: Checkouts
  commandes:
    displayName: Cdes
  cvr_pct:
    displayName: CVR %
  ca_eur:
    displayName: CA €
  depense_ads_eur:
    displayName: Ads €
  roas:
    displayName: ROAS
  gmc_approuves:
    displayName: GMC OK
views:
  - type: table
    name: Toutes les semaines
    order:
      - note.boutique
      - note.periode
      - note.sessions
      - note.sessions_payantes
      - note.paniers
      - note.checkouts_atteints
      - note.commandes
      - note.cvr_pct
      - note.ca_eur
      - note.depense_ads_eur
      - note.roas
      - note.gmc_approuves
