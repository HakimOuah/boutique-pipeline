filters:
  and:
    - type == "croyance"
properties:
  boutique:
    displayName: Boutique
  statut:
    displayName: Statut
  source:
    displayName: Source
  confiance_reconstruction:
    displayName: Confiance
  date_lancement:
    displayName: Lancement
  prediction_reussite_pct:
    displayName: Prédiction %
views:
  - type: table
    name: À compléter en priorité
    filters:
      and:
        - statut == "a_completer"
    order:
      - boutique
      - source
      - confiance_reconstruction
      - date_lancement
  - type: table
    name: Toutes
    order:
      - boutique
      - statut
      - prediction_reussite_pct
