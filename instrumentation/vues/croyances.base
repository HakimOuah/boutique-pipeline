filters:
  and:
    - 'type == "croyance"'
properties:
  boutique:
    displayName: Boutique
  statut:
    displayName: Statut
  source:
    displayName: Source
  confiance_reconstruction:
    displayName: Confiance
  date_lancement:
    displayName: Lancement
  prediction_reussite_pct:
    displayName: Prédiction %
views:
  - type: table
    name: À compléter en priorité
    filters:
      and:
        - 'statut == "a_completer"'
    order:
      - note.boutique
      - note.source
      - note.confiance_reconstruction
      - note.date_lancement
  - type: table
    name: Toutes
    order:
      - note.boutique
      - note.statut
      - note.prediction_reussite_pct
