ge_width": 12, "package_height": 9, "package_length": 18, "gross_weight": "0.467", "package_type": false, "product_unit": 100000015}, "logistics_info_dto": {"delivery_time": 7, "ship_to_country": "FR"}, "product_id_converter_result": {"main_product_id": 1005006738858009, "sub_product_id": "{\"US\":3256806552543257}"}, "ae_item_base_info_dto": {"mobile_detail": "{\"version\":\"2.0.0\",\"moduleList\":[{\"type\":\"text\",\"data\":{\"content\":\"Modèle de moteur Stirling générateur physique avec LED Base en bois volant générateur physique expérience Science jouet éducatif\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":16,\"fontWeight\":\"bold\",\"align\":\"left\",\"color\":\"#000000\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Spécification:\\nNom du produit: Modèle de moteur Stirling\\nMatériau: alliage de zinc, acier inoxydable, verre\\nCouleur: argent/or/argent + rouge/or + rouge (facultatif)\\nTaille: L160 * W85 * H95mm\\nPoids: environ 350g\\nTension de sortie: 3.0 ~ 5.0V\\nCarburant: 95% d'alcool\\nPoids de l'emballage: 450g\\nTaille du paquet: 17,5x9,5x11,5 cm\\n\\nRemarque:\\n\\n-Ce moteur est parfait pour les enfants de plus de 12 ans.\\n\\n-Il est recommandé d'utiliser de l'alcool avec une pureté de 95%\\n\\n-Lorsque le moteur fonctionne, ne touchez pas le verre lorsque vous l'utilisez pour éviter les brûlures.\\n\\n-Les deux extrémités du joint de bielle doivent ajouter une lubrification régulière à l'huile, le piston ne peut pas faire le plein, sinon il ne fonctionnera pas avec la résistance.\\n\\nListe d'emballage\\n1 modèle moteur\\n1 bouteille de lampe à alcool\\n1 compte-gouttes d'alcool (3 ml)\\n1 x tube de verre chauffant de rechange\\n1 perle lumineuse LED\\n1 x Manuel en anglais\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Sd7e83c8f778e449d98240be8e3a26fb0M.jpg\",\"style\":{\"width\":790,\"height\":679}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Sa519bbf2bf324c779387c8eb9c6ed93dk.jpg\",\"style\":{\"width\":790,\"height\":670}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae03.alicdn.com/kf/S9696b33defa745829b604f8928e8e070A.jpg\",\"style\":{\"width\":0,\"height\":0}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae03.alicdn.com/kf/Sc3df218fee484bf396fd1f66b1cf0a747.jpg\",\"style\":{\"width\":0,\"height\":0}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae03.alicdn.com/kf/Sa9371decb6364fac9c05406f667a2b89z.jpg\",\"style\":{\"width\":0,\"height\":0}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae03.alicdn.com/kf/S2481d44c80544fefa508a8a0c632e7e1z.jpg\",\"style\":{\"width\":0,\"height\":0}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S16715935eaf947d19ffcd812388cd46cQ.jpg\",\"style\":{\"width\":790,\"height\":790}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S883adb8120034aba91a69c1b58f21d15b.jpg\",\"style\":{\"width\":790,\"height\":790}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Sbd553dbd309344d8bbba1eab4eeea9f5Z.jpg\",\"style\":{\"width\":790,\"height\":790}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Sb8d2c915837c45eda18169c8f0052a5fC.jpg\",\"style\":{\"width\":790,\"height\":790}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S73e1eded1ce84100888d4881e8756845u.jpg\",\"style\":{\"width\":790,\"height\":790}}}]}", "subject": "Générateur fongique de modèle de moteur Stirling avec LED, base en bois, volant d'inertie, expérience physique, jouet scientifique", "evaluation_count": "0", "sales_count": "11", "product_status_type": "onSelling", "avg_evaluation_rating": "0.0", "separated_listing": false, "currency_code": "CNY", "sl_product": false, "category_id": 200001392, "product_id": 1005006738858009, "detail": "<div class=\"detailmodule_html\"><div class=\"detail-desc-decorate-richtext\"><div class=\"detailmodule_text\"> \n <h1><strong id=\"tl_1\">Mod&egrave;le de moteur Stirling g&eacute;n&eacute;rateur physique avec LED Base en bois volant g&eacute;n&eacute;rateur physique exp&eacute;rience Science jouet &eacute;ducatif</strong></h1> \n</div> \n<div class=\"detailmodule_text\"> \n <p style=\"font-family:OpenSans;font-size:14px;font-weight:300;line-height:20px;white-space:pre-wrap;color:rgb(0, 0, 0);margin-bottom:12px\" class=\"detail-desc-decorate-content\" id=\"tl_2\">Sp&eacute;cification: <br />Nom du produit: Mod&egrave;le de moteur Stirling <br />Mat&eacute;riau: alliage de zinc, acier inoxydable, verre <br />Couleur: argent/or/argent + rouge/or + rouge (facultatif) <br />Taille: L160 * W85 * H95mm <br />Poids: environ 350g <br />Tension de sortie: 3.0 ~ 5.0V <br />Carburant: 95% d'alcool <br />Poids de l'emballage: 450g <br />Taille du paquet: 17,5x9,5x11,5 cm <br /> <br />Remarque: <br /> <br />-Ce moteur est parfait pour les enfants de plus de 12 ans. <br /> <br />-Il est recommand&eacute; d'utiliser de l'alcool avec une puret&eacute; de 95% <br /> <br />-Lorsque le moteur fonctionne, ne touchez pas le verre lorsque vous l'utilisez pour &eacute;viter les br&ucirc;lures. <br /> <br />-Les deux extr&eacute;mit&eacute;s du joint de bielle doivent ajouter une lubrification r&eacute;guli&egrave;re &agrave; l'huile, le piston ne peut pas faire le plein, sinon il ne fonctionnera pas avec la r&eacute;sistance. <br /> <br />Liste d'emballage <br />1 mod&egrave;le moteur <br />1 bouteille de lampe &agrave; alcool <br />1 compte-gouttes d'alcool (3 ml) <br />1 x tube de verre chauffant de rechange <br />1 perle lumineuse LED <br />1 x Manuel en anglais</p> \n</div> \n<div class=\"detailmodule_image\"> \n <img class=\"detail-desc-decorate-image\"