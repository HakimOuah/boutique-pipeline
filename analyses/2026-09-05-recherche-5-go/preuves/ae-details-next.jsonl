"package_height": 13, "package_length": 33, "gross_weight": "0.913", "package_type": false, "product_unit": 100000015}, "logistics_info_dto": {"delivery_time": 7, "ship_to_country": "FR"}, "product_id_converter_result": {"main_product_id": 1005010401748173, "sub_product_id": "{\"US\":3256810215433421}"}, "ae_item_base_info_dto": {"mobile_detail": "{\"version\":\"2.0.0\",\"moduleList\":[{\"type\":\"text\",\"data\":{\"content\":\"\\n    modname=ckediteur\\n\",\"style\":{}}},{\"type\":\"text\",\"data\":{\"content\":\"Attention : ce n'est pas des marchandises d'occasion, c'est une coulée et un demi-marqué à la main et peut ressembler à l'ancienne, ne l'achetez pas si vous mente, merci\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Remarque :\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"1.l'image montrent simplement le pour chaque bol, c'est juste un morceau de bol, taille en option\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"2. Veuillez comprendre qui c'est normal si il y a n'y a n'y aident les cicatrices parce que fait à la main/marqué, c'est de défauts de polissage et il y a été incontournable pour les marques de forgeage faites à la main.C'est un phénomène normal et n'affecte pas l'utilisation du produit.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"3. Veuillez vous permet pour une légère différence de couleur causée par une lumière photographique et un moniteur informatique différent.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"4. Veuillez le permet d'un erreur de 0 à 0,5 cm en raison d'un lot de marchandises fait à la main et différent.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Matériaux : il fait du métal et du laiton, n'est pas du métal pur ou du laiton pur, merci de votre compréhension.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Caractéristiques :\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"【Ensemble de bols chantants tibétains】 comprenant un bol chantant en métal fabriqué à la main, un beau coussin doux cousu à la main (livraison de couleur aléatoire) et un ataquant en cuir amélioré, un design traditionnel et une fabrication exquise.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"【Créer des sons de guérison et de relaxation】 Avec des sons de résonance et de guérison parfaits, le bol chant est idéal pour le yoga, la méditation, la guérison spirituelle, la relaxation quotidienne, etc.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"【Easy to Make Peaceful Tones】 À l'aide d'un gâche en bois pour frotter le bord du bol, vous pouvez facilement faire des sons paisibles et détendent qui réduit le stress et favorise la guérison spirituelle, du mental et physique.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"【Théorie de guérison sonore】 Les processus de guérison sont initiés par la formation de nos cerveaux pour synchroniser la résonance parfaite des bols. Le son et les vibrations favorisent un état détendu pour la méditation et la réflexion.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"【Taille grande et son puissant】 Grande taille de 8,5-20 cm et son plus puissant, vous pouvez apporter le bol chantant pour les cours de yoga, la salle de méditation, le bureau ou tout endroit vous souhaitez.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Spécifications :\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Matériel : Article en laiton et en métal\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Taille : veuillez vous renseigner sur la marque de la taille de l'image SKU.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Liste des colis :\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"1 * Bol d'écriture chantante tibétain\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"1 * Attacheur en cuir\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"1 * Coussin (Livraison de couleurs aléatoires)\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Saecbfd62ffe347b890b573e0efa569faa.jpg\",\"style\":{\"width\":1200,\"height\":1200}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S8dfce18b24bd48409fb50505887134fdt.jpg\",\"style\":{\"width\":1200,\"height\":1200}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Sfb654e283c3a4ba1a7cba83d7f095858h.jpg\",\"style\":{\"width\":2000,\"height\":3000}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S17c1f2bfc46748d3b1971783b1f7cf7dm.jpg\",\"style\":{\"width\":1200,\"height\":1200}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Sd8c372e12a0e49f6b72d8b40e7b2d31d3.jpg\",\"style\":{\"width\":1200,\"height\":1177}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S46fc804d7d17442aad2145d9646909a2D.jpg\",\"style\":{\"width\":1200,\"height\":1200}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S0c215e22e6b247d7b96ce5a2aea8aa2du.jpg\",\"style\":{\"width\":1200,\"height\":1200}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Sb3cdbdb8e2624ec5845fa4407d07d706E.jpg\",\"style\":{\"width\":1200,\"height\":1200}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S1bf1e798a3c247b5a68df8a46c5de02fT.jpg\",\"style\":{\"width\":1200,\"height\":1200}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Sbccb2f6091374f62849542704a3a343cP.jpg\",\"style\":{\"width\":1200,\"height\":1200}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S7f5082e60ef54687a748840db26926dbl.jpg\",\"style\":{\"width\":1200,\"height\":1200}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S0773d7d86f5a4137bf52442b14ac7576F.jpg\",\"style\":{\"width\":1200,\"height\":1200}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S784f80d1b7e84f58859f1a163049c9e6A.jpg\",\"style\":{\"width\":1200,\"height\":1200}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Sdf7807d557584e8fac97e734bdc5442e6.jpg\",\"style\":{\"width\":1200,\"height\":1200}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Sb98c7818a8db4d82ada181dff2a53b9d6.jpg\",\"style\":{\"width\":1200,\"height\":1200}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S627f72de6c2e45a38665b5cb86ecf19du.jpg\",\"style\":{\"width\":1200,\"height\":1200}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Scee018ab6555462faf20a699a9aa1a3bW.jpg\",\"style\":{\"width\":1200,\"height\":1200}}}]}", "subject": "Ensemble de bols chantants tibétains en option, taille 8.5 ~ 20CM, bol d'écriture utile pour la méditation, le Yoga, la Relaxation, la guérison des chakras, la prière", "evaluation_count": "0", "sales_count": "27", "product_status_type": "onSelling", "avg_evaluation_rating": "0.0", "separated_listing": false, "currency_code": "CNY", "sl_product": false, "category_id": 201549902, "product_id": 1005010401748173, "detail": "<div class=\"detailmodule_html\"><div class=\"detail-desc-decorate-richtext\"><div class=\"detailmodule_html\">\n <div class=\"detail-desc-decorate-richtext\">\n  <div>\n   <div style=\"overflow:hidden;height:0px\" id=\"tl_1\">\n    modname=ckeditor\n   </div>\n   <div>\n    <p><span style=\"color:rgb(159, 5, 0);font-size:20px\"><strong id=\"tl_2\">Attention : ce ne sont pas des produits d'occasion, ils sont moul&eacute;s et martel&eacute;s &agrave; moiti&eacute; et ils peuvent para&icirc;tre anciens, n'achetez pas si cela vous d&eacute;range, merci</strong></span></p>\n    <p><span style=\"color:rgb(159, 5, 0);font-size:20px\"><strong id=\"tl_3\">Remarque :</strong></span></p>\n    <p><span style=\"font-size:14px\"><strong id=\"tl_4\">1. L'image montre juste le pour chaque bol, c'est juste</strong></span><strong><span style=\"color:rgba(244,78,59,255);font-size:14px\" id=\"tl_5\">UNE pi&egrave;ce</span></strong><span style=\"font-size:14px\"><strong id=\"tl_6\">du bol, taille en option</strong></span></p>\n    <p><span style=\"font-size:14px\"><strong id=\"tl_7\">2. Veuillez comprendre qu'il est normal s'il y a des cicatrices car elles ont &eacute;t&eacute; faites &agrave; la main/marron&eacute;es. Il y a quelques d&eacute;fauts de polissage et il y aura des marques de forgeage in&eacute;vitables sur la main.C'est un ph&eacute;nom&egrave;ne normal et n'affecte pas l'utilisation du produit.</strong></span></p>\n    <p><span style=\"font-size:14px\"><strong id=\"tl_8\">3. Veuillez permettre une l&eacute;g&egrave;re diff&eacute;rence de couleur caus&eacute;e par la lumi&egrave;re de la photographie et les diff&eacute;rents &eacute;crans d'ordinateur.</strong></span></p>\n    <p><span style=\"font-size:14px\"><strong id=\"tl_9\">4. Veuillez permettre une erreur d'environ 0 &agrave; 0,5 cm en raison de produits faits &agrave; la main et diff&eacute;rents lots.</strong></span></p>\n    <br />\n    <p id=\"tl_10\"><span style=\"color:rgb(159, 5, 0);font-size:20px\"><strong>Mat&eacute;riaux :</strong></span>je <span style=\"font-size:14px\"><strong>Il est fait de m&eacute;tal et de laiton, ce n'est pas du m&eacute;tal pur ou du laiton pur, merci de votre compr&eacute;hension.</strong></span></p>\n    <p><span style=\"color:rgb(159, 5, 0);font-size:20px\"><strong id=\"tl_11\">Caract&eacute;ristiques :</strong></span></p>\n    <p><span style=\"color:rgb(159, 5, 0)\">【</span><span style=\"color:rgb(159, 5, 0)\"><strong id=\"tl_12\">Ensemble de bols chantants tib&eacute;tains】</strong></span><strong id=\"tl_13\">Comprenant un bol chantant en m&eacute;tal fabriqu&eacute; &agrave; la main, un magnifique coussin doux cousu &agrave; la main (livraison de couleurs al&eacute;atoires) et un percuteur en cuir am&eacute;lior&eacute;, un design traditionnel et une fabrication exquise.</strong></p>\n    <p><strong>【</strong><span style=\"color:rgb(159, 5, 0)\"><strong id=\"tl_14\">Cr&eacute;ez des sons curatifs et relaxants】</strong></span><strong id=\"tl_15\">Dot&eacute; d'une r&eacute;sonance et de sons de gu&eacute;rison parfaits, le bol chantantant est id&eacute;al pour le yoga, la m&eacute;ditation, la gu&eacute;rison spirituelle, la relaxation quotidienne, etc.</strong></p>\n    <p><strong>【</strong><span style=\"color:rgb(159, 5, 0)\"><strong id=\"tl_16\">Facile &agrave; cr&eacute;er des tons paisibles :</strong></span><strong id=\"tl_17\">Utilisez simplement la g&acirc;che en bois pour frotter le bord du bol, vous pouvez facilement &eacute;mettre des sons paisibles et relaxants qui r&eacute;duisent le stress et favorisent la gu&eacute;rison spirituelle, mentale et physique.</strong></p>\n    <p><strong>【</strong><span style=\"color:rgb(159, 5, 0)\"><strong id=\"tl_18\">Th&eacute;orie de la gu&eacute;rison sonore】</strong></span><strong id=\"tl_19\">Les processus de gu&eacute;rison sont initi&eacute;s en entra&icirc;nant nos ondes c&eacute;r&eacute;brales pour se synchroniser avec la r&eacute;sonance parfaite des bols. Le son et les vibrations favorisent un &eacute;tat d&eacute;tendu pour une m&eacute;ditation et une r&eacute;flexion profondes.</strong></p>\n    <p><strong>【</strong><span style=\"color:rgb(159, 5, 0)\"><strong id=\"tl_20\">Grande taille et son puissant】</strong></span><strong id=\"tl_21\">Grande taille de 8,5 &agrave; 20 cm et son plus puissant, vous pouvez amener le bol chantant aux cours de yoga, &agrave; la salle de m&eacute;ditation, au bureau ou &agrave; tout autre endroit de votre choix.</strong></p>\n    <br />\n    <p><span style=\"color:rgb(159, 5, 0);font-size:20px\"><strong id=\"tl_22\">Sp&eacute;cifications :</strong></span></p>\n    <br />\n    <p><strong id=\"tl_23\">Mat&eacute;riel: article en laiton et en m&eacute;tal</strong></p>\n    <p><strong id=\"tl_24\">Taille : veuillez vous r&eacute;f&eacute;rer &agrave; la marque de taille de l'image SKU.</strong></p>\n    <br />\n    <p><span style=\"color:rgb(159, 5, 0);font-size:20px\"><strong id=\"tl_25\">Liste des paquets :</strong></span></p>\n    <p><strong id=\"tl_26\">1 * bol d'&eacute;criture tib&eacute;tain chantant</strong></p>\n    <p><strong id=\"tl_27\">1 * percuteur en cuir</strong></p>\n    <p><span style=\"font-size:18px\"><span style=\"color:rgb(255, 0, 0)\"><strong id=\"tl_28\">1 * coussin (livraison de couleur al&eacute;atoire)</strong></span></span></p>\n    <p><img src=\"https://ae01.alicdn.com/kf/Saecbfd62ffe347b890b573e0efa569faa.jpg\" slate-data-type=\"image\" /><img src=\"https://ae01.alicdn.com/kf/S8dfce18b24bd48409fb50505887134fdt.jpg\" slate-data-type=\"image\" /><img src=\"https://ae01.alicdn.com/kf/Sfb654e283c3a4ba1a7cba83d7f095858h.jpg\" slate-data-type=\"image\" /><img src=\"https://ae01.alicdn.com/kf/S17c1f2bfc46748d3b1971783b1f7cf7dm.jpg\" slate-data-type=\"image\" /><img src=\"https://ae01.alicdn.com/kf/Sd8c372e12a0e49f6b72d8b40e7b2d31d3.jpg\" slate-data-type=\"image\" /><img src=\"https://ae01.alicdn.com/kf/S46fc804d7d17442aad2145d9646909a2D.jpg\" slate-data-type=\"image\" /><img src=\"https://ae01.alicdn.com/kf/S0c215e22e6b247d7b96ce5a2aea8aa2du.jpg\" slate-data-type=\"image\" /><img src=\"https://ae01.alicdn.com/kf/Sb3cdbdb8e2624ec5845fa4407d07d706E.jpg\" slate-data-type=\"image\" /><img src=\"https://ae01.alicdn.com/kf/S1bf1e798a3c247b5a68df8a46c5de02fT.jpg\" slate-data-type=\"image\" /><img src=\"https://ae01.alicdn.com/kf/Sbccb2f6091374f62849542704a3a343cP.jpg\" slate-data-type=\"image\" /><img src=\"https://ae01.alicdn.com/kf/S7f5082e60ef54687a748840db26926dbl.jpg\" slate-data-type=\"image\" /><img src=\"https://ae01.alicdn.com/kf/S0773d7d86f5a4137bf52442b14ac7576F.jpg\" slate-data-type=\"image\" /><img src=\"https://ae01.alicdn.com/kf/S784f80d1b7e84f58859f1a163049c9e6A.jpg\" slate-data-type=\"image\" /><img src=\"https://ae01.alicdn.com/kf/Sdf7807d557584e8fac97e734bdc5442e6.jpg\" slate-data-type=\"image\" /><img src=\"https://ae01.alicdn.com/kf/Sb98c7818a8db4d82ada181dff2a53b9d6.jpg\" slate-data-type=\"image\" /><img src=\"https://ae01.alicdn.com/kf/S627f72de6c2e45a38665b5cb86ecf19du.jpg\" slate-data-type=\"image\" /><img src=\"https://ae01.alicdn.com/kf/Scee018ab6555462faf20a699a9aa1a3bW.jpg\" slate-data-type=\"image\" /></p>\n   </div>\n  </div>\n </div>\n</div>\n<br /></div></div>\r\n"}, "manufacturer_info": {"address": "CN- Room104 Unit 2, Building 6, Phase 6, Changfeng Community, Lugu Street, Yulue District, Changsha City, Hunan Province", "phone": "", "country_name": "China", "email": "37952168312@qq.com ", "phone_prefix": ""}, "has_whole_sale": false, "ae_item_properties": {"ae_item_property": [{"attr_name_id": 2, "attr_value_id": 201512802, "attr_name": "Nom de marque", "attr_value": "NONE"}, {"attr_name_id": 400000603, "attr_value_id": 23399591357, "attr_name": "Produit chimique à haute préoccupation", "attr_value": "Aucun"}, {"attr_name_id": 200001540, "attr_value_id": 698, "attr_name": "Patin de batterie", "attr_value": "5"}, {"attr_name_id": 219, "attr_value_id": 9441741844, "attr_name": "Origine", "attr_value": "CN (Origine)"}, {"attr_name_id": -1, "attr_value_id": -1, "attr_name": "Produit chimique hautement dangereux", "attr_value": "Aucun"}, {"attr_name_id": -1, "attr_name": "Choice", "attr_value": "yes"}]}, "ae_store_info": {"store_id": 1104699029, "shipping_speed_rating": "4.8", "communication_rating": "4.8", "store_name": "Shop1104699029 Store", "store_country_code": "CN", "item_as_described_rating": "4.7"}}}
