 {"package_width": 27, "package_height": 26, "package_length": 27, "gross_weight": "1.980", "package_type": false, "product_unit": 100000015}, "logistics_info_dto": {"delivery_time": 7, "ship_to_country": "FR"}, "product_id_converter_result": {"main_product_id": 1005009179721367, "sub_product_id": "{\"US\":3256808993406615}"}, "ae_item_base_info_dto": {"mobile_detail": "{\"version\":\"2.0.0\",\"moduleList\":[{\"type\":\"media\",\"data\":{\"mediaId\":330356903461,\"previewImage\":\"https://img.alicdn.com/imgextra/i1/6000000002707/O1CN0160yYXY1VrqrSAOQkd_!!6000000002707-0-tbvideo.jpg\",\"src\":\"http://ae-cn.alicdn.com/1FM2hzgl8HyZSdbyJBD/8ebg0RrMappOjBk4obm\"}},{\"type\":\"text\",\"data\":{\"content\":\"Bol chantant en cristal 8 \\\"10\\\", Note B/G, Chakra au Quartz givré, bol chant tibétain, méditation, Yoga, maillet de guérison sonore et joint torique\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":16,\"fontWeight\":\"bold\",\"align\":\"left\",\"color\":\"#000000\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Description : \\n Les bols chantants en cristal sont fabriqués à partir de cristal pur à 99,99 %, un bol chantant en cristal de quartz produit par un cristal de quartz pur élevé, c'est un excellent pour la méditation et la guérison. \\n ​ Chaque bol chantant en cristal sera inspection strictement avant d'expédition. Le son est incroyable, clair, fort et profond et riche ressonation par vibration avec la puissance pour guérir, lorsque vous jouez le bol chantant en cristal, avec la puissance pour la santé. \\n ​ vous n'êtes pas encore une thérapie sonore, mais aussi une guérison des cristaux qui est extrêmement pénétrante. \\n Nous avons un technicien professionnel et une machine pour produire des bols. Chaque bol est par les artisans, plusieurs polis, soigneusement sélectionnés et puis envoyés à votre côté. \\n Comment jouer : \\n Un chemin est 