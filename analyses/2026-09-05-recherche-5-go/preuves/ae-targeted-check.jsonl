m/play/5000547646213.mp4"}]}, "image_urls": "https://ae01.alicdn.com/kf/S67064994e1e0481abfff141223e9f59aQ.jpg;https://ae01.alicdn.com/kf/S879cdac1c69c41279a94a016d1b295912.jpg;https://ae01.alicdn.com/kf/S21000eab9c5b44fb831f6a2174ffee6cV.jpg;https://ae01.alicdn.com/kf/S790331b086b84bcc9002562720f6496fA.jpg"}, "package_info_dto": {"package_width": 20, "package_height": 20, "package_length": 20, "gross_weight": "1.110", "package_type": false, "product_unit": 100000015}, "logistics_info_dto": {"delivery_time": 7, "ship_to_country": "FR"}, "product_id_converter_result": {"main_product_id": 1005012862994440, "sub_product_id": "{\"US\":3256812676679688}"}, "ae_item_base_info_dto": {"mobile_detail": "{\"version\":\"2.0.0\",\"moduleList\":[{\"type\":\"text\",\"data\":{\"content\":\"Caractéristiques : \\n Fabriquée en cuivre, cette chaîne de pluie est résistante à la rouille. Le cuivre naturel brille chaudement au soleil et développe une belle patine au fil du temps, ajoutant un charme artistique unique à la décoration de votre jardin tout en maintenant sa solidité structurelle. \\n Inspiré de l'esthétique des temples traditionnels, chaque lien soigneusement conçu incarne l'élégance minimaliste. Plus qu'un simple tuyau de descente, il sert de l'objet d'une beauté artistique, apportant tranquillité aux espaces extérieurs, fusionnant la nature avec des harmonies spirituelles. \\n Redirige efficacement l'eau de pluie des toits avec des flux doux, empêchant les éclaboussures tout en produisant des sons apaisants de gouttelettes. Crée une ambiance paisible qui attire les oiseaux et améliore l'écosystème de votre jardin grâce à des mélodies naturelles rythmiques. \\n Parfait pour les jardins, les patios ou les balcons, cette chaîne en cuivre accrocheuse rehausse l'esthétique du paysage. Sa présence artistique complète divers styles de décoration, notamment les espaces à thème naturel recherchant des points focal de méditation et une esthétique visuelle raffinée. \\n Conception de suspension simple, aucun outil spécial requis pour l'installation sous les avant-toits. La construction en cuivre résistant à la corrosion nécessite seulement des nettoyages occasionnels pour préserver sa beauté, garantissant des performances fiables pendant des années malgré les changements de saison. \\n Spécifications : \\n Taille : environ 19,5 x 7,6 cm / 7,67 x 2,99 pouces \\n Styles:A/B \\n Composant : Cuivre \\n Le forfait comprend : \\n 1 pièce Chaîne de récupération d'eau de pluie \\n Remarque: \\n Veuillez tenir compte des erreurs de 1 à 2 cm dues à la mesure manuelle, veuillez vous assurer que vous n'en avez pas peur avant de commander. \\n En raison des différences entre les différents moniteurs, l'image peut ne pas refléter la couleur réelle. \\n Merci pour votre compréhension. \\n \\n \\n \\n\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S606b2654e86a4e25bdd7199e9cb2897eR.jpg\",\"style\":{\"width\":800,\"height\":800}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S879cdac1c69c41279a94a016d1b295912.jpg\",\"style\":{\"width\":800,\"height\":800}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Scc712e23c3c64750bf077acc11a9b2a4M.jpg\",\"style\":{\"width\":800,\"height\":800}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Sd37929fc657b4110a16642b91b98a0d1S.jpg\",\"style\":{\"width\":800,\"height\":800}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S21000eab9c5b44fb831f6a2174ffee6cV.jpg\",\"style\":{\"width\":800,\"height\":800}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S790331b086b84bcc9002562720f6496fA.jpg\",\"style\":{\"width\":800,\"height\":800}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S19469c9cedeb4321b48b80fcdeb5c8f8O.jpg\",\"style\":{\"width\":800,\"height\":800}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Sc1f86aebfdf046e993f12c725171cc47k.jpg\",\"style\":{\"width\":800,\"height\":800}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S67064994e1e0481abfff141223e9f59aQ.jpg\",\"style\":{\"width\":800,\"height\":800}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S2e1db42f5ee74424ad89d21f6d4f986cl.jpg\",\"style\":{\"width\":800,\"height\":800}}}]}", "subject": "Chaîne pluie décorative en cuivre, Dragon sautant poisson, pour effet cascade jardin serein, Drainage d'eau élégant", "evaluation_count": "0", "sales_count": "0", "product_status_type": "onSelling", "avg_evaluation_rating": "0.0", "separated_listing": false, "currency_code": "USD", "sl_product": false, "category_id": 200332184, "product_id": 1005012862994440, "detail": "<div class=\"detailmodule_html\"><div class=\"detail-desc-decorate-richtext\"><div class=\"detailmodule_html\">\n <div class=\"detail-desc-decorate-richtext\">\n  <div style=\"font-size: 18px;\" id=\"tl_1\">\n   <b>Caract&eacute;ristiques :</b> \n   <br /> \n   <span style=\"background: white; color: #fff;\">OOTDTY</span> &nbsp; \n   <br />Fabriqu&eacute;e en cuivre, cette cha&icirc;ne de pluie est r&eacute;sistante &agrave; la rouille. Le cuivre naturel brille chaleureusement au soleil et d&eacute;veloppe une belle patine avec le temps, ajoutant un charme artistique unique &agrave; votre d&eacute;coration de jardin tout en conservant son int&eacute;grit&eacute; structurelle. \n   <br />Inspir&eacute; par l'esth&eacute;tique traditionnelle des temples, chaque maillon finement travaill&eacute; incarne une &eacute;l&eacute;gance minimaliste. Plus qu'un simple tuyau de descente fonctionnel, il se pr&eacute;sente comme une œuvre d'art sereine qui apporte la tranquillit&eacute; aux espaces ext&eacute;rieurs, alliant nature et harmonies spirituelles. \n   <br />Canalise efficacement l'&eacute;coulement de l'eau de pluie avec des flux doux, &eacute;vitant les &eacute;claboussures tout en produisant des sons apaisants de gouttes. Cr&eacute;e une ambiance paisible qui attire les oiseaux et am&eacute;liore l'&eacute;cosyst&egrave;me de votre jardin avec des m&eacute;lodies naturelles rythm&eacute;es. \n   <br />Parfaite pour les jardins, les patios ou les balcons, cette cha&icirc;ne en cuivre accrocheuse rehausse l'esth&eacute;tique du paysage. Sa pr&eacute;sence artistique s'harmonise avec diff&eacute;rents styles de d&eacute;coration, en particulier les espaces &agrave; th&egrave;me naturel recherchant des points focaux m&eacute;ditatifs et un attrait visuel raffin&eacute;. \n   <br />La conception simple &agrave; suspendre ne n&eacute;cessite aucun outil sp&eacute;cial pour l'installation sous les avant-toits. La construction en cuivre r&eacute;sistant &agrave; la corrosion ne n&eacute;cessite qu'un nettoyage occasionnel pour pr&eacute;server sa beaut&eacute;, assurant des ann&eacute;es de performances fiables au fil des saisons. \n   <br /> \n   <br /> \n   <b>Sp&eacute;cifications :</b> \n   <br />Taille : Env. 19,5x7,6 cm / 7,67x2,99 pouces \n   <br />Styles : A/B \n   <br />Composant : Cuivre \n   <br /> \n   <br /> \n   <b>Le paquet comprend :</b> \n   <br />Cha&icirc;ne de pluie - 1 pi&egrave;ce \n   <br /> \n   <br /> \n   <b>Remarque :</b> \n   <br />1. Veuillez permettre des erreurs de 1 &agrave; 2 cm en raison de la mesure manuelle, assurez-vous que cela ne vous d&eacute;range pas avant de commander. \n   <br />2. En raison des diff&eacute;rences entre les diff&eacute;rents moniteurs, l'image peut ne pas refl&eacute;ter la couleur r&eacute;elle. \n   <br />Merci pour votre compr&eacute;hension. \n   <br /> \n   <br /> \n   <img src=\"https://ae-pic-a1.aliexpress-media.com/kf/S606b2654e86a4e25bdd7199e9cb2897eR.jpg\" style=\"width:800px;\" /> \n   <br /> \n   <img src=\"https://ae-pic-a1.aliexpress-media.com/kf/S879cdac1c69c41279a94a016d1b295912.jpg\" style=\"width:800px;\" /> \n   <br /> \n   <img src=\"https://ae-pic-a1.aliexpress-media.com/kf/Scc712e23c3c64750bf077acc11a9b2a4M.jpg\" style=\"width:800px;\" /> \n   <br /> \n   <img src=\"https://ae-pic-a1.aliexpress-media.com/kf/Sd37929fc657b4110a16642b91b98a0d1S.jpg\" style=\"width:800px;\" /> \n   <br /> \n   <img src=\"https://ae-pic-a1.aliexpress-media.com/kf/S21000eab9c5b44fb831f6a2174ffee6cV.jpg\" style=\"width:800px;\" /> \n   <br /> \n   <img src=\"https://ae-pic-a1.aliexpress-media.com/kf/S790331b086b84bcc9002562720f6496fA.jpg\" style=\"width:800px;\" /> \n   <br /> \n   <img src=\"https://ae-pic-a1.aliexpress-media.com/kf/S19469c9cedeb4321b48b80fcdeb5c8f8O.jpg\" style=\"width:800px;\" /> \n   <br /> \n   <img src=\"https://ae-pic-a1.aliexpress-media.com/kf/Sc1f86aebfdf046e993f12c725171cc47k.jpg\" style=\"width:800px;\" /> \n   <br /> \n   <img src=\"https://ae-pic-a1.aliexpress-media.com/kf/S67064994e1e0481abfff141223e9f59aQ.jpg\" style=\"width:800px;\" /> \n   <br /> \n   <img src=\"https://ae-pic-a1.aliexpress-media.com/kf/S2e1db42f5ee74424ad89d21f6d4f986cl.jpg\" style=\"width:800px;\" />\n  </div>\n </div>\n</div></div></div>\r\n"}, "manufacturer_info": {"address": "39H54, Fortune Building, No. 88 Fuhua 3rd Road, Gangxia Community, Futian Street, Futian District, Shenzhen", "phone": "17727547543", "country_name": "China", "email": "smtfsjj@163.com", "phone_prefix": "86"}, "has_whole_sale": true, "ae_item_properties": {"ae_item_property": [{"attr_name_id": 2, "attr_value_id": 201512802, "attr_name": "Nom de marque", "attr_value": "NONE"}, {"attr_name_id": 219, "attr_value_id": 9441741844, "attr_name": "Origine", "attr_value": "CN (Origine)"}, {"attr_name_id": 400000603, "attr_value_id": 23399591357, "attr_name": "Produit chimique à haute p