_info_dto": {"delivery_time": 7, "ship_to_country": "FR"}, "product_id_converter_result": {"main_product_id": 1005008660338324, "sub_product_id": "{\"US\":3256808474023572}"}, "ae_item_base_info_dto": {"mobile_detail": "{\"version\":\"2.0.0\",\"moduleList\":[{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S3c3864ff90234a83b3e1072615d6adddz.png\",\"style\":{\"width\":750,\"height\":1000}}},{\"type\":\"text\",\"data\":{\"content\":\"Sublimez votre espace avec cette suspension en travertin jaune naturel.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Fabriqué en pierre de travertin jaune véritable, il présente une texture poreuse unique qui dégage un charme rustique et épuré. Disponible en deux tailles (D11cm/H16.5cm ou D12cm/H10cm), il s'intègre parfaitement aux sources de lumière LED. Parfait comme veilleuse de chevet ou comme accent décoratif dans une salle à manger, alliant beauté naturelle et ambiance chaleureuse pour une touche de décoration intemporelle et organique.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Sabd8dc60b2e14d4c974b7ebeb210333fv.png\",\"style\":{\"width\":1200,\"height\":1200}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Sb03b47d0dae44aff8ab440707894a36aQ.png\",\"style\":{\"width\":1200,\"height\":1200}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Sfce8f5a2308c4639b00c0c6bc7a9a30as.jpg\",\"style\":{\"width\":750,\"height\":750}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S84b610328dc848b0834fcf4730c430a21.jpg\",\"style\":{\"width\":800,\"height\":800}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S79b2c1a40a4c4ea7a1b79dbaa3cb7febV.jpg\",\"style\":{\"width\":800,\"height\":800}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S4dbb84189ef84aa0bf985a65b2cb53c4R.jpg\",\"style\":{\"width\":800,\"height\":800}}}]}", "subject": "Lustre de style japonais, luminaire suspendu en pierre de haute qualité, suspension en travertin, lampe suspendue LED pour îlot de cuisine, salon", "evaluation_count": "0", "sales_count": "1000+", "sl_related_product_id": 1005012039762699, "product_status_type": "onSelling", "avg_evaluation_rating": "0.0", "separated_listing": false, "currency_code": "CNY", "sl_product": true, "category_id": 200001064, "product_id": 1005008660338324, "detail": "<div class=\"detailmodule_html\"><div class=\"detail-desc-decorate-richtext\"><p><img src=\"https://ae01.alicdn.com/kf/S3c3864ff90234a83b3e1072615d6adddz.png\" slate-data-type=\"image\" /></p>\n<p id=\"tl_1\">Sublimez votre espace avec ceci. <span style=\"background-color:rgba(0, 0, 0, 0);color:rgb(0, 0, 0);font-size:16px;font-family:ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;\"><strong>Suspension en travertin jaune naturel</strong></span>.</p>\n<p id=\"tl_2\">Fabriqu&eacute; &agrave; partir de v&eacute;ritable travertin jaune, il pr&eacute;sente une texture poreuse unique qui d&eacute;gage un charme rustique wabi-sabi. Disponible en deux tailles (D11cm/H16,5cm ou D12cm/H10cm), il s'adapte parfaitement aux sources lumineuses LED. Parfait comme lampe de chevet ou &eacute;l&eacute;ment d&eacute;coratif de salle &agrave; manger, il allie beaut&eacute; naturelle et ambiance chaleureuse pour une touche de d&eacute;coration intemporelle et organique.</p>\n<p><img src=\"https://ae01.alicdn.com/kf/Sa