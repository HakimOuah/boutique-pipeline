{
  "sections": {
    "main": {
      "type": "cart",
      "blocks": {
        "cart_header_blocks": {
          "type": "_cart-header-blocks",
          "static": true,
          "settings": {
            "wrap_in_card": true,
            "color_scheme": "scheme-2",
            "margin_top": 15,
            "margin_bottom": 0
          },
          "blocks": {
            "banner_franco": {
              "type": "custom-code",
              "settings": {
                "show_on_display": "desktop_and_mobile",
                "custom_liquid": "<div class=\"lm-cart-banner\">\n  <span>Livraison offerte en France, suivie. 7 à 17 jours ouvrés</span>\n</div>\n<style>\n  .lm-cart-banner{display:flex;align-items:center;justify-content:center;gap:.5rem;margin:0 0 12px;padding:.7rem 1rem;border-radius:12px;background:#24211B;color:#F6F3EC;font-size:.85rem;font-weight:500;text-align:center;box-shadow:inset 3px 0 0 #C08A2D}\n</style>",
                "margin_top": 0,
                "margin_bottom": 0,
                "additional_class": ""
              },
              "blocks": {},
              "name": "Bannière livraison"
            }
          },
          "block_order": [
            "banner_franco"
          ]
        },
        "cart_footer_resume_blocks": {
          "type": "_cart-footer-resume-blocks",
          "static": true,
          "settings": {
            "wrap_in_card": false,
            "color_scheme": "",
            "margin_top": 0,
            "margin_bottom": 0
          },
          "blocks": {
            "discount_code_3WJdxK": {
              "type": "_discount-code",
              "name": "t:discount_code",
              "settings": {
                "style": "normal",
                "accordion_heading": "Ajouter un code de réduction",
                "button_text": "Appliquer",
                "placeholder": "Code de réduction",
                "margin_top": 0,
                "margin_bottom": 10,
                "additional_class": ""
              },
              "blocks": {}
            },
            "upsell_pieces": {
              "type": "custom-code",
              "settings": {
                "show_on_display": "desktop_and_mobile",
                "custom_liquid": "<div class=\"lm-cart-upsell\">\n{%- liquid\n  assign lm_upsell = 'lustre-anneau-led-led-795468,plafonnier-led-565566,suspension-effet-pierre-led-073999,suspension-verre-814554' | split: ','\n  assign lm_count = 0\n-%}\n  <p class=\"lm-cart-upsell__title\">À regarder aussi</p>\n  <div class=\"lm-cart-upsell__list\">\n{%- for h in lm_upsell -%}\n  {%- if lm_count >= 2 -%}{%- break -%}{%- endif -%}\n  {%- assign p = all_products[h] -%}\n  {%- if p != empty and p.available -%}\n    {%- assign in_cart = false -%}\n    {%- for item in cart.items -%}\n      {%- if item.product.handle == h -%}{%- assign in_cart = true -%}{%- endif -%}\n    {%- endfor -%}\n    {%- unless in_cart -%}\n      {%- assign v = p.selected_or_first_available_variant -%}\n      <div class=\"lm-cart-upsell__item\">\n        <a href=\"{{ p.url }}\" class=\"lm-cart-upsell__media\">\n          <img src=\"{{ p.featured_image | image_url: width: 160 }}\" alt=\"{{ p.title | escape }}\" width=\"56\" height=\"56\" loading=\"lazy\">\n        </a>\n        <div class=\"lm-cart-upsell__info\">\n          <a href=\"{{ p.url }}\" class=\"lm-cart-upsell__name\">{{ p.title }}</a>\n          <div class=\"lm-cart-upsell__row\">\n            <span class=\"lm-cart-upsell__price\">{{ v.price | money }}</span>\n            <button type=\"button\" class=\"lm-upsell-add\" data-variant-id=\"{{ v.id }}\">Ajouter</button>\n          </div>\n        </div>\n      </div>\n      {%- assign lm_count = lm_count | plus: 1 -%}\n    {%- endunless -%}\n  {%- endif -%}\n{%- endfor -%}\n  </div>\n</div>\n<style>\n  .lm-cart-upsell{margin:0 0 12px}\n  .lm-cart-upsell__title{font-family:var(--font-heading--family,serif);color:#24211B;font-size:1.05rem;margin:0 0 .8rem}\n  .lm-cart-upsell__list{display:flex;flex-direction:column;gap:.9rem}\n  .lm-cart-upsell__item{display:grid;grid-template-columns:56px 1fr;align-items:center;gap:.75rem}\n  .lm-cart-upsell__media{display:block}\n  .lm-cart-upsell__item img{width:56px;height:56px;object-fit:cover;border-radius:10px;background:#F6F3EC;display:block}\n  .lm-cart-upsell__info{display:flex;flex-direction:column;gap:.35rem;min-width:0}\n  .lm-cart-upsell__name{font-size:.85rem;line-height:1.25;color:#24211B;text-decoration:none}\n  .lm-cart-upsell__row{display:flex;align-items:center;justify-content:space-between;gap:.5rem}\n  .lm-cart-upsell__price{font-size:.9rem;font-weight:600;color:#24211B;white-space:nowrap}\n  .lm-upsell-add{border:0;cursor:pointer;background:#24211B;color:#F6F3EC;font-size:.78rem;font-weight:600;padding:.4rem .85rem;border-radius:999px;white-space:nowrap}\n  .lm-upsell-add:hover{background:#C08A2D;color:#24211B}\n</style>\n<script>\n(function(){\n  document.addEventListener('click', function(e){\n    var btn = e.target.closest('.lm-upsell-add');\n    if(!btn) return;\n    e.preventDefault();\n    var id = parseInt(btn.getAttribute('data-variant-id'), 10);\n    if(!id) return;\n    btn.disabled = true;\n    fetch('/cart/add.js', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({id:id, quantity:1})})\n      .then(function(r){ if(!r.ok) throw r; location.reload(); })\n      .catch(function(){ btn.disabled = false; });\n  });\n})();\n</script>",
                "margin_top": 0,
                "margin_bottom": 10,
                "additional_class": ""
              },
              "blocks": {},
              "name": "Upsell pièces"
            }
          },
          "block_order": [
            "upsell_pieces",
            "discount_code_3WJdxK"
          ]
        },
        "cart_footer_blocks": {
          "type": "_cart-footer-blocks",
          "static": true,
          "settings": {
            "wrap_in_card": false,
            "color_scheme": "",
            "margin_top": 0,
            "margin_bottom": 0
