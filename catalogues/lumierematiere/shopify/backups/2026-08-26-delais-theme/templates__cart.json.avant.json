            "payment_methods_TfmeJy": {
              "type": "payment-methods",
              "name": "t:payment_methods",
              "settings": {
                "show_on_display": "desktop_and_mobile",
                "alignment_desktop": "flex-start",
                "alignment_mobile": "center",
                "icon_size": 35,
