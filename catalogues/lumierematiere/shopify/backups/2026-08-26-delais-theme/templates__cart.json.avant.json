            },
            "accordions_UBXTAD": {
              "type": "accordions",
              "name": "t:accordions",
              "settings": {
                "show_on_display": "desktop_and_mobile",
                "icon": "caret",
                "dividers": true,
                "additional_class": ""
              },
              "blocks": {
                "accordion_eYqGh9": {
                  "type": "_accordion",
                  "settings": {
                    "show_on_display": "desktop_and_mobile",
                    "heading": "Retours, 30 jours",
                    "open_by_default": false,
                    "icon": "none",
                    "icon_custom": "",
                    "additional_class": ""
                  },
                  "blocks": {
                    "text_9gnHYi": {
                      "type": "text",
                      "settings": {
                        "show_on_display": "desktop_and_mobile",
                        "text": "<p>Vous avez 30 jours après réception pour renvoyer un luminaire, sans frais de remise en stock (14 jours de rétractation légale, étendus à 30). Écrivez à <a href=\"mailto:contact@lumierematiere.fr\">contact@lumierematiere.fr</a> : on vous indique comment procéder. Si vous changez simplement d’avis, les frais de retour restent à votre charge. Le remboursement part sous 7 jours après contrôle du colis.</p>",
                        "text_style": "paragraph",
                        "paragraph_font_size": "normal",
                        "font_weight": 400,
                        "alignment": "left",
                        "alignment_mobile": "left",
                        "show_read_more": false,
                        "read_more_length": 200,
                        "read_more_text": "Voir plus",
                        "read_less_text": "Voir moins",
                        "margin_top": 0,
                        "margin_bottom": 0,
                        "additional_class": ""
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_9gnHYi"
                  ]
                },
                "accordion_dYtf9Y": {
                  "type": "_accordion",
                  "settings": {
                    "show_on_display": "desktop_and_mobile",
                    "heading": "Livraison offerte en France",
                    "open_by_default": false,
                    "icon": "none",
                    "icon_custom": "",
                    "additional_class": ""
                  },
                  "blocks": {
                    "text_jGApxp": {
                      "type": "text",
                      "settings": {
                        "show_on_display": "desktop_and_mobile",
                        "text": "<p>Livraison offerte en France métropolitaine, Corse incluse, sans minimum. On prépare le colis en 1 à 2 jours ouvrés si la commande arrive avant 16h00, heure de Paris. L’acheminement prend 6 à 15 jours ouvrés, soit 7 à 17 jours au total. Le suivi part par e-mail dès l’expédition.</p>",
                        "text_style": "paragraph",
                        "paragraph_font_size": "normal",
                        "font_weight": 400,
                        "alignment": "left",
                        "alignment_mobile": "left",
                        "show_read_more": false,
                        "read_more_length": 200,
                        "read_more_text": "Voir plus",
                        "read_less_text": "Voir moins",
                        "margin_top": 0,
                        "margin_bottom": 0,
                        "additional_class": ""
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_jGApxp"
                  ]
                }
              },
              "block_order": [
                "accordion_eYqGh9",
                "accordion_dYtf9Y"
              ]
            }
          },
          "block_order": [
            "cart_accelerated_checkout_pCRFtz",
            "payment_methods_TfmeJy",
            "accordions_UBXTAD"
          ]
        }
      },
      "settings": {
        "color_scheme": "scheme-1",
        "show_variant_options_labels": false,
        "show_remove_button": true,
        "show_cart_count": true,
        "padding_top": 50,
        "padding_bottom": 50
      }
    },
    "lm_reco": {
