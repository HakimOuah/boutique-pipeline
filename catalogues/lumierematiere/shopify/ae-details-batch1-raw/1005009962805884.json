livery_time": 7, "ship_to_country": "FR"}, "product_id_converter_result": {"main_product_id": 1005009962805884, "sub_product_id": "{\"US\":3256809776491132}"}, "ae_item_base_info_dto": {"mobile_detail": "{\"version\":\"2.0.0\",\"moduleList\":[{\"type\":\"text\",\"data\":{\"content\":\"Lampe suspendue en bambou, lustres en rotin naturel E27, tricotés à la main, décoration de café, restaurant, salon, lampe suspendue E27 40/50/60CM \\n 【BAMBOU NATUREL】 --- Nous utilisons des lattes de bambou de haute qualité, chaque pièce est soigneusement traitée, avec de belles lignes, une certaine brillance, est stable et ne se déforme pas facilement. Chaque œuvre en bambou parait apporter la forêt de bambou à la maison. garder un style indépendant et décontracté. \\n 【ABAT-JOUR À DOUBLE COUCHE】— La couche extérieure est un abat-jour en bambou tissé à la main, plein de charme zen et de belles lumières et ombres, et la couche intérieure est un abat-jour en PVC à haute transmission lumineuse et lumière douce. \\n 【Lumière décorative idéale】 - Vous pouvez placer la lampe dans la chambre, le salon, le balcon, etc. C'est une lampe décorative idéale, par jour comme par nuit. C'est également un excellent cadeau pour les amis ou la famille. \\n 【SOURCE DE LUMIÈRE】 - Base de source lumineuse E27 conforme aux normes internationales, incluant une ampoule LED, 12W, lumière chaude. Vous pouvez également utiliser d'autres ampoules, compatibles avec la plupart des ampoules.\",\"style\":{\"fontSize\":13,\"fontWeight\":\"normal\",\"align\":\"left\",\"color\":\"#434649\"}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Sc82822c3ec1b435dad56760cc650f4ed3.jpg\",\"style\":{\"width\":1240,\"height\":1766}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S635e032d615e494cb9d69ba1fef017deh.jpg\",\"style\":{\"width\":1240,\"height\":1590}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S43f9af0ee17240478b1817563466f36cu.jpg\",\"style\":{\"width\":1240,\"height\":1712}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Sf028ce4c6a874e779dacb4a39586f8891.jpg\",\"style\":{\"width\":1240,\"height\":1397}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S1299b09f0fff407bbeb574113bf933f0d.jpg\",\"style\":{\"width\":1240,\"height\":1397}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Se73d87d2d3b943c683d35094b26c1010R.jpg\",\"style\":{\"width\":1240,\"height\":1416}}}]}", "subject": "Lampe à suspension en bambou lustres en rotin naturel E27 tricoté à la main Café Restaurant salon décor lampe suspendue E27 40/50/60CM", "evaluation_count": "0", "sales_count": "20", "product_status_type": "onSelling", "avg_evaluation_rating": "0.0", "separated_listing": false, "currency_code": "CNY", "sl_product": false, "category_id": 200001064, "product_id": 1005009962805884, "detail": "<div class=\"detailmodule_html\"><div class=\"detail-desc-decorate-richtext\"><div class=\"detailmodule_html\">\n <div class=\"detail-desc-decorate-richtext\">\n  <div style=\"overflow:hidden;width:750px;height:12123px\">\n   <div style=\"overflow:hidden;width:750px;height:12123px\">\n    <div>\n     <span style=\"font-size:26px\"><strong id=\"tl_1\">Lampe Suspendue en Bambou, Lustres en Rotin Naturel, E27, Tress&eacute;e &agrave; la Main, D&eacute;coration pour Caf&eacute;, Restaurant, Salon, Lampe Suspendue E27 40/50/60CM</strong></span>\n     <br />\n    </div>\n    <ul style=\"font-family:&quot;Amazon Ember&quot;, Arial, sans-serif;font-size:14px;font-weight:400;letter-spacing:normal;text-align:start;white-space:normal;color:rgb(15, 17, 17);background-color:rgb(255, 255, 255);margin:0px 0px 0px 18px;margin-bottom:0px;margin-top:0px;margin-left:18px;margin-right:0px;padding:0px;padding-bottom:0px;padding-top:0px;padding-left:0px;padding-right:0px;box-sizing:border-box\" class=\"a-unordered-list a-vertical a-spacing-mini\" align=\"start\">\n     <li style=\"margin:0px;margin-bottom:0px;margin-top:0px;margin-left:0px;margin-right:0px;list-style:disc;box-sizing:border-box\" class=\"a-spacing-mini\"><p><span class=\"a-list-item\" style=\"color:var(--__dChNmAmGoMXsw4B,#0f1111)\" id=\"tl_2\">【BAMBOU NATUREL】 --- Nous utilisons des bandes de bambou de haute qualit&eacute;, chaque pi&egrave;ce est trait&eacute;e avec soin, pr&eacute;sentant de belles lignes, un certain brillant, et est stable et difficile &agrave; d&eacute;former.Chaque œuvre en bambou semble ramener la for&ecirc;t de bambous &agrave; la maison.maintenir un style ind&eacute;pendant et d&eacute;contract&eacute;.</span></p></li>\n     <li style=\"margin:0px;margin-bottom:0px;margin-top:0px;margin-left:0px;margin-right:0px;list-style:disc;box-sizing:border-box\" class=\"a-spacing-mini\"><p><span class=\"a-list-item\" style=\"color:var(--__dChNmAmGoMXsw4B,#0f1111)\" id=\"tl_3\">【ABAT-JOUR DOUBLE &Eacute;TAGE】--- La couche ext&eacute;rieure est un abat-jour en bambou tiss&eacute; &agrave; la main, d&eacute;bordant de charme zen et offrant de magnifiques jeux d'ombre et de lumi&egrave;re. La couche int&eacute;rieure est un abat-jour en PVC &agrave; haute transmission de la lumi&egrave;re, diffusant une lumi&egrave;re douce.</span></p></li>\n     <li style=\"margin:0px;margin-bottom:0px;margin-top:0px;margin-left:0px;margin-right:0px;list-style:disc;box-sizing:border-box\" class=\"a-spacing-mini\"><p><span class=\"a-list-item\" style=\"color:var(--__dChNmAmGoMXsw4B,#0f1111)\" id=\"tl_4\">【Lumi&egrave;re d&eacute;corative parfaite】 ---&nbsp;vous pouvez placer la lampe dans la chambre, le salon, le balcon, etc.C'est une lampe d&eacute;corative parfaite, de jour comme de nuit.Cela peut &eacute;galement &ecirc;tre un excellent cadeau pour les amis ou la famille.</span></p></li>\n     <li style=\"margin:0px;margin-bottom:0px;margin-top:0px;margin-left:0px;margin-right:0px;list-style:disc;box-sizing:border-box\" class=\"a-spacing-mini\"><p><span class=\"a-list-item\" style=\"color:var(--__dChNmAmGoMXsw4B,#0f1111)\" id=\"tl_5\">【SOURCE DE LUMI&Egrave;RE】 --- Base de source lumineuse E27 standard international, comprenant une ampoule LED, 12 W, lumi&egrave;re chaude. Vous pouvez &eacute;galement utiliser d'autres ampoules, adapt&eacute;es &agrave; la plupart des ampoules.</span></p></li>\n    </ul>\n    <div>\n     <br />\n     <br />\n     <img style=\"display:block;width:100%\" width=\"100%\" src=\"https://ae01.alicdn.com/kf/Sc82822c3ec1b435dad56760cc650f4ed3.jpg\" slate-data-type=\"image\" /> \n     <img style=\"display:block;width:100%\" width=\"100%\" src=\"https://ae01.alicdn.com/kf/S635e032d615e494cb9d69ba1fef017deh.jpg\" slate-data-type=\"image\" /> \n     <img style=\"display:block;width:100%\" width=\"100%\" src=\"https://ae01.alicdn.com/kf/S43f9af0ee17240478b1817563466f36cu.jpg\" slate-data-type=\"image\" /> \n     <img style=\"display:block;width:100%\" width=\"100%\" src=\"https://ae01.alicdn.com/kf/Sf028ce4c6a874e779dacb4a39586f8891.jpg\" slate-data-type=\"image\" /> \n     <img style=\"display:block;width:100%\" width=\"100%\" src=\"https://ae01.alicdn.com/kf/S1299b09f0fff407bbeb574113bf933f0d.jpg\" slate-data-type=\"image\" /> \n     <img style=\"display:block;width:100%\" width=\"100%\" src=\"https://ae01.alicdn.com/kf/Se73d87d2d3b943c683d35094b26c1010R.jpg\" slate-data-type=\"image\" />\n    </div>\n   </div>\n  </div>\n </div>\n</div>\n<br /></div></div>\r\n"}, "manufacturer_info": {"address": "605 Longdulou Shuanglonghuayuan Xixiangdadao shenzhen", "phone": "18676651002", "country_name": "China", "email": "host@joyinled.com", "phone_prefix": "86"}, "has_whole_sale": false, "ae_item_properties": {"ae_item_property": [{"attr_name_id": 2, "attr_value_id": 203521195, "attr_name": "Nom de marque", "attr_value": "JOYINLED"}, {"attr_name_id": 200000535, "attr_value_id": 349906, "attr_name": "Les ampoules sont-elles incluses", "attr_value": "Non"}, {"attr_name_id": 400081201, "attr_value_id": 23710544761, "attr_name": "Inclut-il le PCBA ?", "attr_value"