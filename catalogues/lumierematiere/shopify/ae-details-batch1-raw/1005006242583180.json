ia_info_dto": {"image_urls": "https://ae01.alicdn.com/kf/S6bd631b0cb7e4981b5e80db01b4823f5i.jpg;https://ae01.alicdn.com/kf/S8b2e7182c97f4c828f3cb0b8348838e0F.jpg;https://ae01.alicdn.com/kf/Seacea18ebfe1495a8fcd5af558bd3b534.jpg;https://ae01.alicdn.com/kf/Sfbddec9b173547bda08e9232987065dfl.jpg;https://ae01.alicdn.com/kf/Sa4299e0c8d6e460590dd75fcf732214eK.jpg;https://ae01.alicdn.com/kf/S8ed3c09f07d04bc191eecbe29eabe6d8H.jpg"}, "package_info_dto": {"package_width": 55, "package_height": 35, "package_length": 101, "gross_weight": "4.000", "package_type": false, "product_unit": 100000015, "base_unit": 1}, "logistics_info_dto": {"delivery_time": 7, "ship_to_country": "FR"}, "product_id_converter_result": {"main_product_id": 1005006242583180, "sub_product_id": "{\"US\":3256806056268428}"}, "ae_item_base_info_dto": {"mobile_detail": "{\"version\":\"2.0.0\",\"moduleList\":[{\"type\":\"media\",\"data\":{\"mediaId\":5000190588038,\"previewImage\":\"https://ae-pic-a1.aliexpress-media.com/kf/S6fff7151f7ad43b0995f9d15d0cfe800J.jpg\",\"src\":\"https://video.aliexpress-media.com/play/u/2670889926/v/5000190588038\",\"style\":{\"width\":720,\"height\":960}}},{\"type\":\"text\",\"data\":{\"content\":\"Lampe LED suspendue Vintage en bambou tissé à la main, lustre tissé en rotin pour salon, cuisine et décoration de la maison\",\"style\":{\"fontSize\":13,\"align\":\"left\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Fabriqué de bambou écologique, tissage artisanal, texture exquise et détails fins.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Facile à installer, ampoule porte-lampe E27, la source de lumière LED est plus d'économie d'énergie.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"L'éclairage suspendu au plafond créatif est une grande art fait à la main, de style rétro, élégant et accrocheur.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Convient pour bar, chambre à coucher, salle à manger, couloir, maison, salon, porche, restaurants, expositions et bâtiments spéciaux.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"C'est une décoration, cela peut être un excellent cadeau pour les amis comme cadeau de pendaison de crémaillère.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Le paquet comprend :\",\"style\":{\"fontSize\":13}}},{\"type\":\"text\",\"data\":{\"content\":\"Lustre 1 pièce (ampoule non incluse)\",\"style\":{\"fontSize\":13}}},{\"type\":\"text\",\"data\":{\"content\":\"Remarque :\",\"style\":{\"fontSize\":13}}},{\"type\":\"text\",\"data\":{\"content\":\"1. La couleur pourrait être légèrement différente en raison de l'étalonnage des couleurs de chaque moniteur individuel. \\n 2. Veuillez permet à mesurer légèrement la déviation en raison de la mesure manuelle. \\n 3. Soyez légèrement différences dans les spécifications de densité de différents lots de produits, (mesure manuelle, erreur de taille d'environ 2 cm) \\n 4.Le câble est disponible en noir ou blanc, si vous le souhaitez d'un de ces couleurs, veuillez nous contacter, sinon nous l'enverrons au hasard.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Sdafba38f2b7a46aca30967e22d29b1d7m.jpg\",\"style\":{\"width\":800,\"height\":800,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/A9bd073e48c874b009ebed521ac51d7f0N.jpg\",\"style\":{\"width\":800,\"height\":476,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S83e1ed8fe6e3422e92716c6111061b1bC.jpg\",\"style\":{\"width\":800,\"height\":800,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S014973246ee946d0ad2e8ef5c310940fY.jpg\",\"style\":{\"width\":960,\"height\":2026,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Sd9c502e9b2f644d4a89d316e28eb2ac6j.jpg\",\"style\":{\"width\":1600,\"height\":1600,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Sef6df719d9e7400388c68767eecad48bs.jpg\",\"style\":{\"width\":944,\"height\":1178,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S62de1f753eca4c0c9b55015770b57f92p.jpg\",\"style\":{\"width\":1600,\"height\":1600,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Se64af12f337a413e8b6c2b67dbedd8442.jpg\",\"style\":{\"width\":1600,\"height\":1600,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/k