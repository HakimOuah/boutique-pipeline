{% comment %}
  Cosy Cat House — customer reviews carousel (native scroll-snap, no app).
  Adapted from the parc's bv-avis-clients section. DEMO CONTENT ONLY on the draft theme.
{% endcomment %}
{%- liquid
  assign align = section.settings.heading_alignment
-%}
<style>
  #cch-reviews-{{ section.id }} {
    --cch-stars: {{ section.settings.stars_color }};
    --cch-cardbg: {{ section.settings.card_background }};
    --cch-border: {{ section.settings.card_border }};
    --cch-title: {{ section.settings.title_color }};
    --cch-text: {{ section.settings.text_color }};
    --cch-cards: {{ section.settings.cards }};
    {% if section.settings.background != blank %}background: {{ section.settings.background }};{% endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #cch-reviews-{{ section.id }} .cchr__inner { max-width: 1300px; margin: 0 auto; padding-inline: 20px; }
  #cch-reviews-{{ section.id }} .cchr__head { display:flex; align-items:flex-end; justify-content:space-between; gap:16px; flex-wrap:wrap; margin: 0 0 22px; }
  #cch-reviews-{{ section.id }} .cchr__heading {
    font-family: var(--font-heading--family, serif);
    color: {{ section.settings.heading_color }}; font-size: clamp(24px, 3vw, 34px); line-height: 1.12;
    margin: 0; text-align: {{ align }};
  }
  #cch-reviews-{{ section.id }} .cchr__summary { color: {{ section.settings.heading_color }}; font-size: 15px; display:flex; align-items:center; gap:8px; }
  #cch-reviews-{{ section.id }} .cchr__viewport { position: relative; }
  #cch-reviews-{{ section.id }} .cchr__track {
    display: flex; gap: 16px; list-style: none; margin: 0; padding: 4px 2px 8px;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  #cch-reviews-{{ section.id }} .cchr__track::-webkit-scrollbar { display: none; }
  #cch-reviews-{{ section.id }} .cchr__card {
    flex: 0 0 calc((100% - (var(--cch-cards) - 1) * 16px) / var(--cch-cards));
    scroll-snap-align: start; box-sizing: border-box;
    background: var(--cch-cardbg); border: 1px solid var(--cch-border); border-radius: 14px;
    padding: 20px; box-shadow: 0 2px 10px rgba(31, 41, 55, 0.06);
    display: flex; flex-direction: column;
    font-family: var(--font-body--family, sans-serif);
  }
  #cch-reviews-{{ section.id }} .cchr__top { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
  #cch-reviews-{{ section.id }} .cch-stars { display: inline-flex; gap: 3px; }
  #cch-reviews-{{ section.id }} .cch-star { width: 22px; height: 22px; border-radius: 4px; background: #e6e6e6; display: inline-flex; align-items: center; justify-content: center; }
  #cch-reviews-{{ section.id }} .cch-star.is-on { background: var(--cch-stars); }
  #cch-reviews-{{ section.id }} .cch-star svg { width: 14px; height: 14px; fill: #fff; }
  #cch-reviews-{{ section.id }} .cch-verified { display: inline-flex; align-items: center; gap: 5px; margin-left: auto; font-size: 12px; color: #6b7280; white-space: nowrap; }
  #cch-reviews-{{ section.id }} .cch-verified__dot { width: 16px; height: 16px; border-radius: 50%; background: #9aa4ad; display: inline-flex; align-items: center; justify-content: center; }
  #cch-reviews-{{ section.id }} .cch-verified__dot svg { width: 9px; height: 9px; stroke: #fff; fill: none; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  #cch-reviews-{{ section.id }} .cchr__title { font-weight: 700; color: var(--cch-title); font-size: 15px; margin: 0 0 6px; line-height: 1.25; }
  #cch-reviews-{{ section.id }} .cchr__text { color: var(--cch-text); font-size: 14px; line-height: 1.55; margin: 0 0 14px; }
  #cch-reviews-{{ section.id }} .cchr__meta { color: var(--cch-text); font-size: 13px; margin: auto 0 0; }
  #cch-reviews-{{ section.id }} .cchr__meta strong { color: var(--cch-title); font-weight: 600; }
  #cch-reviews-{{ section.id }} .cchr__nav { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--cch-border); background: #fff; color: var(--cch-title); font-size: 22px; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(31,41,55,.12); }
  #cch-reviews-{{ section.id }} .cchr__nav:hover { background: var(--cch-title); color: #fff; }
  #cch-reviews-{{ section.id }} .cchr__nav--prev { left: -8px; }
  #cch-reviews-{{ section.id }} .cchr__nav--next { right: -8px; }
  @media (max-width: 749px) {
    #cch-reviews-{{ section.id }} .cchr__card { flex-basis: 84%; }
    #cch-reviews-{{ section.id }} .cchr__nav { display: none; }
  }
</style>
<div id="cch-reviews-{{ section.id }}" class="cch-reviews"{% if section.settings.anchor_id != blank %} data-anchor="{{ section.settings.anchor_id }}"{% endif %}>
  {% if section.settings.anchor_id != blank %}<span id="{{ section.settings.anchor_id }}"></span>{% endif %}
  <div class="cchr__inner">
    <div class="cchr__head">
      {%- if section.settings.heading != blank -%}<h2 class="cchr__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.summary != blank -%}<div class="cchr__summary">{{ section.settings.summary }}</div>{%- endif -%}
    </div>
    <div class="cchr__viewport">
      {%- if section.blocks.size > section.settings.cards -%}
        <button class="cchr__nav cchr__nav--prev" type="button" aria-label="Previous" data-dir="-1">&#8249;</button>
      {%- endif -%}
      <ul class="cchr__track" role="list">
        {%- for block in section.blocks -%}
          {%- assign r = block.settings.rating -%}
          <li class="cchr__card" {{ block.shopify_attributes }}>
            <div class="cchr__top">
              <div class="cch-stars" role="img" aria-label="Rated {{ r }} out of 5">
                {%- for i in (1..5) -%}
                  <span class="cch-star{% if i <= r %} is-on{% endif %}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.8 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg></span>
                {%- endfor -%}
              </div>
              {%- if block.settings.verified -%}
                <span class="cch-verified"><span class="cch-verified__dot"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span>Verified</span>
              {%- endif -%}
            </div>
            {%- if block.settings.title != blank -%}<p class="cchr__title">{{ block.settings.title | escape }}</p>{%- endif -%}
            {%- if block.settings.text != blank -%}<p class="cchr__text">{{ block.settings.text | escape | newline_to_br }}</p>{%- endif -%}
            {%- if block.settings.author != blank or block.settings.date_text != blank -%}
              <p class="cchr__meta">
                {%- if block.settings.author != blank -%}<strong>{{ block.settings.author | escape }}</strong>{%- endif -%}
                {%- if block.settings.author != blank and block.settings.date_text != blank -%}, {% endif -%}
                {%- if block.settings.date_text != blank -%}{{ block.settings.date_text | escape }}{%- endif -%}
              </p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- if section.blocks.size > section.settings.cards -%}
        <button class="cchr__nav cchr__nav--next" type="button" aria-label="Next" data-dir="1">&#8250;</button>
      {%- endif -%}
    </div>
  </div>
</div>
<script>
  (function () {
    var root = document.getElementById('cch-reviews-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('.cchr__track');
    root.querySelectorAll('.cchr__nav').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var card = track.querySelector('.cchr__card');
        var step = card ? card.getBoundingClientRect().width + 16 : 320;
        track.scrollBy({ left: step * parseInt(btn.getAttribute('data-dir'), 10), behavior: 'smooth' });
      });
    });
  })();
</script>
{% schema %}
{
  "name": "CCH — Customer reviews",
  "tag": "section",
  "class": "cch-reviews-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What cat owners say" },
    { "type": "html", "id": "summary", "label": "Summary (HTML)", "default": "★★★★★ 4.8/5 · 312 reviews" },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] },
    { "type": "range", "id": "cards", "label": "Cards per row (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "color", "id": "background", "label": "Section background", "default": "#1F5E3A" },
    { "type": "color", "id": "heading_color", "label": "Heading colour", "default": "#FFF7ED" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#E5E7EB" },
    { "type": "color", "id": "title_color", "label": "Review title colour", "default": "#1F2937" },
    { "type": "color", "id": "text_color", "label": "Review text colour", "default": "#4B5563" },
    { "type": "color", "id": "stars_color", "label": "Stars colour", "default": "#00B67A" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 5, "default": 50, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 5, "default": 50, "unit": "px" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "checkbox", "id": "verified", "label": "Show “Verified”", "default": true },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "author", "label": "Author" },
        { "type": "text", "id": "date_text", "label": "Date text" }
      ]
    }
  ],
  "presets": [ { "name": "CCH — Customer reviews" } ]
}
{% endschema %}
