<section class="dp-faq" style="--dp-accent: {{ section.settings.accent_color }}; --dp-text: {{ section.settings.text_color }};">
  {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="dp-faq__items">
    {%- for block in section.blocks -%}
      <details class="dp-faq__item" {{ block.shopify_attributes }}>
        <summary>
          <span>{{ block.settings.question }}</span>
          <span class="dp-faq__symbol" aria-hidden="true">+</span>
        </summary>
        <div class="dp-faq__answer rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .dp-faq {
    color: var(--dp-text);
    margin-inline: auto;
    max-width: 820px;
  }

  .dp-faq h2 {
    color: var(--dp-accent);
    margin: 0 0 24px;
  }

  .dp-faq__item {
    border-bottom: 1px solid color-mix(in srgb, var(--dp-text) 18%, transparent);
  }

  .dp-faq__item summary {
    align-items: center;
    cursor: pointer;
    display: flex;
    font-weight: 650;
    gap: 20px;
    justify-content: space-between;
    list-style: none;
    min-height: 52px;
    padding-block: 14px;
  }

  .dp-faq__item summary::-webkit-details-marker {
    display: none;
  }

  .dp-faq__symbol {
    color: var(--dp-accent);
    font-size: 1.4rem;
    transition: transform 180ms ease;
  }

  .dp-faq__item[open] .dp-faq__symbol {
    transform: rotate(45deg);
  }

  .dp-faq__answer {
    line-height: 1.65;
    padding: 0 44px 20px 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:dropilot.faq.name",
  "tag": "div",
  "class": "dp-section",
  "max_blocks": 12,
  "settings": [
    {"type": "text", "id": "heading", "label": "t:dropilot.common.heading", "default": "Vos questions, nos réponses"},
    {"type": "color", "id": "accent_color", "label": "t:dropilot.common.accent_color", "default": "#0E3A5A"},
    {"type": "color", "id": "text_color", "label": "t:dropilot.common.text_color", "default": "#1C2830"}
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:dropilot.faq.question",
      "settings": [
        {"type": "text", "id": "question", "label": "t:dropilot.faq.question", "default": "Question fréquente"},
        {"type": "richtext", "id": "answer", "label": "t:dropilot.faq.answer", "default": "<p>Réponse claire, factuelle et vérifiée.</p>"}
      ]
    }
  ],
  "presets": [{"name": "t:dropilot.faq.name", "blocks": [{"type": "question"}, {"type": "question"}, {"type": "question"}]}]
}
{% endschema %}

