_direction\": \"row\",\n        \"vertical_on_mobile\": true,\n        \"horizontal_alignment\": \"space-between\",\n        \"vertical_alignment\": \"center\",\n        \"align_baseline\": false,\n        \"horizontal_alignment_flex_direction_column\": \"flex-start\",\n        \"vertical_alignment_flex_direction_column\": \"center\",\n        \"gap\": 40,\n        \"section_width\": \"page-width\",\n        \"section_height\": \"\",\n        \"section_height_custom\": 50,\n        \"background_media\": \"none\",\n        \"background_color\": \"#f7f4ee\",\n        \"video_position\": \"cover\",\n        \"background_image_position\": \"cover\",\n        \"toggle_overlay\": false,\n        \"overlay_color\": \"#00000026\",\n        \"overlay_style\": \"solid\",\n        \"gradient_direction\": \"to top\",\n        \"border\": \"none\",\n        \"border_width\": 1,\n        \"border_opacity\": 100,\n        \"border_color\": \"\",\n        \"border_radius\": 0,\n        \"padding-block-start\": 48,\n        \"padding-block-end\": 48\n      }\n    },\n    \"faq_objections\": {\n      \"type\": \"section\",\n      \"blocks\": {\n        \"heading\": {\n          \"type\": \"text\",\n          \"settings\": {\n            \"text\": \"<h2>Vos questions, nos réponses</h2>\",\n            \"width\": \"100%\",\n            \"max_width\": \"normal\",\n            \"alignment\": \"left\",\n            \"type_preset\": \"h3\",\n            \"font\": \"var(--font-body--family)\",\n            \"font_size\": \"1rem\",\n            \"line_height\": \"normal\",\n            \"letter_spacing\": \"normal\",\n            \"case\": \"none\",\n            \"wrap\": \"pretty\",\n            \"text_color\": \"#0e3a5a\",\n            \"background\": false,\n            \"background_color\": \"#00000026\",\n            \"corner_radius\": 0,\n            \"padding-block-start\": 0,\n            \"padding-block-end\": 0,\n            \"padding-inline-start\": 0,\n            \"padding-inline-end\": 0\n          },\n          \"blocks\": {}\n        },\n        \"accordion\": {\n          \"type\": \"accordion\",\n          \"settings\": {\n            \"icon\": \"caret\",\n            \"dividers\": true,\n            \"divider_color\": \"\",\n            \"type_preset\": \"h6\",\n            \"background_color\": \"\",\n            \"text_color\": \"\",\n            \"border\": \"none\",\n            \"border_width\": 1,\n            \"border_opacity\": 100,\n            \"border_color\": \"\",\n            \"border_radius\": 0,\n            \"padding-block-start\": 0,\n            \"padding-block-end\": 0,\n            \"padding-inline-start\": 0,\n            \"padding-inline-end\": 0\n          },\n          \"blocks\": {\n            \"r1\": {\n              \"type\": \"_accordion-row\",\n              \"settings\": {\n                \"heading\": \"Comment choisir la solution adaptée à mon eau ?\",\n                \"open_by_default\": false,\n                \"icon\": \"none\",\n                \"width\": 20\n              },\n              \"blocks\": {\n                \"t1\": {\n                  \"type\": \"text\",\n                  \"settings\": {\n                    \"text\": \"<p>Pour améliorer le goût de l'eau sans rien installer, commencez par une carafe filtrante. Pour équiper un robinet, vérifiez le filetage et le média du filtre. Pour l'eau de boisson de tout le foyer, l'osmoseur sous évier est le plus complet. En cas de doute, écrivez-nous avant de commander : nous vous orientons selon votre eau et votre logement.</p>\",\n                    \"width\": \"100%\",\n                    \"max_width\": \"normal\",\n                    \"alignment\": \"left\",\n                    \"type_preset\": \"rte\",\n                    \"font\": \"var(--font-body--family)\",\n                    \"font_size\": \"1rem\",\n                    \"line_height\": \"normal\",\n                    \"letter_spacing\": \"normal\",\n                    \"case\": \"none\",\n                    \"wrap\": \"pretty\",\n                    \"text_color\": \"\",\n                    \"background\": false,\n                    \"background_color\": \"#00000026\",\n                    \"corner_radius\": 0,\n                    \"padding-block-start\": 0,\n                    \"padding-block-end\": 0,\n                    \"padding-inline-start\": 0,\n                    \"padding-inline-end\": 0\n                  },\n                  \"blocks\": {}\n                }\n              },\n              \"block_order\": [\n                \"t1\"\n              ]\n            },\n            \"r2\": {\n              \"type\": \"_accordion-row\",\n              \"settings\": {\n                \"heading\": \"Faut-il des travaux ou un plombier ?\",\n                \"open_by_default\": false,\n                \"icon\": \"none\",\n                \"width\": 20\n              },\n              \"blocks\": {\n                \"t2\": {\n                  \"type\": \"text\",\n                  \"settings\": {\n                    \"text\": \"<p>Non pour la grande majorité de nos produits : un filtre se visse, une carafe se remplit, un pommeau de douche se change en deux minutes. L'osmoseur sous évier demande un raccordement simple, sans percer ni modifier votre plomberie. C'est pensé aussi bien pour les locataires que pour les propriétaires.</p>\",\n                    \"width\": \"100%\",\n                    \"max_width\": \"normal\",\n                    \"alignment\": \"left\",\n                    \"type_preset\": \"rte\",\n                    \"font\": \"var(--font-body--family)\",\n                    \"font_size\": \"1rem\",\n                    \"line_height\": \"normal\",\n                    \"letter_spacing\": \"normal\",\n                    \"case\": \"none\",\n                    \"wrap\": \"pretty\",\n                    \"text_color\": \"\",\n                    \"background\": false,\n                    \"background_color\": \"#00000026\",\n                    \"corner_radius\": 0,\n                    \"padding-block-start\": 0,\n                    \"padding-block-end\": 0,\n                    \"padding-inline-start\": 0,\n                    \"padding-inline-end\": 0\n                  },\n                  \"blocks\": {}\n                }\n              },\n              \"block_order\": [\n                \"t2\"\n              ]\n            },\n            \"r3\": {\n              \"type\": \"_accordion-row\",\n              \"settings\": {\n                \"heading\": \"Vos produits sont-ils vraiment efficaces ?\",\n                \"open_by_default\": false,\n                \"icon\": \"none\",\n                \"width\": 20\n              },\n              \"blocks\": {\n                \"t3\": {\n                  \"type\": \"text\",\n                  \"settings\": {\n                    \"text\": \"<p>Nous présentons chaque produit à partir de données concrètes et distinguons ce qui est documenté de ce qui reste à confirmer, sans inventer de taux de filtration ni de certification. Vous décidez en connaissance de cause, et notre service client répond à vos questions avant l'achat.</p>\",\n                    \"width\": \"100%\",\n                    \"max_width\": \"normal\",\n                    \"alignment\": \"left\",\n                    \"type_preset\": \"rte\",\n                    \"font\": \"var(--font-body--family)\",\n                    \"font_size\": \"1rem\",\n                    \"line_height\": \"normal\",\n                    \"letter_spacing\": \"normal\",\n                    \"case\": \"none\",\n                    \"wrap\": \"pretty\",\n                    \"text_color\": \"\",\n                    \"background\": false,\n                    \"background_color\": \"#00000026\",\n                    \"corner_radius\": 0,\n                    \"padding-block-start\": 0,\n                    \"padding-block-end\": 0,\n                    \"padding-inline-start\": 0,\n                    \"padding-inline-end\": 0\n                  },\n                  \"blocks\": {}\n                }\n              },\n              \"block_order\": [\n                \"t3\"\n              ]\n            },\n            \"r4\": {\n              \"type\": \"_accordion-row\",\n              \"settings\": {\n                \"heading\": \"Les dispositifs anti-calcaire adoucissent-ils l'eau ?\",\n                \"open_by_default\": false,\n                \"icon\": \"none\",\n                \"width\": 20\n              },\n              \"blocks\": {\n                \"t4\": {\n                  \"type\": \"text\",\n                  \"settings\": {\n                    \"text\": \"<p>Non. L'efficacité des procédés magnétiques et électroniques n'est pas démontrée scientifiquement : nous ne promettons aucune réduction de la dureté. Ce sont des dispositifs d'appoint, sans sel ni entretien, qui ne remplacent pas un adoucisseur à résine. Nous préférons vous le dire clairement.</p>\",\n                    \"width\": \"100%\",\n                    \"max_width\": \"normal\",\n                    \"alignment\": \"left\",\n                    \"type_preset\": \"rte\",\n                    \"font\": \"var(--font-body--family)\",\n                    \"font_size\": \"1rem\",\n                    \"line_height\": \"normal\",\n                    \"letter_spacing\": \"normal\",\n                    \"case\": \"none\",\n                    \"wrap\": \"pretty\",\n                    \"text_color\": \"\",\n                    \"background\": false,\n                    \"background_color\": \"#00000026\",\n                    \"corner_radius\": 0,\n                    \"padding-block-start\": 0,\n                    \"padding-block-end\": 0,\n                    \"padding-inline-start\": 0,\n                    \"padding-inline-end\": 0\n                  },\n                  \"blocks\": {}\n                }\n              },\n          