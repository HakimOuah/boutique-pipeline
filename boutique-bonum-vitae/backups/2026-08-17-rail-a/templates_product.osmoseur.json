      "type": "bv-avis-clients",
      "blocks": {
        "review_ecpmHn": {
          "type": "review",
          "settings": {
            "rating": 5,
            "verified": true,
            "title": "Enfin une eau agréable à boire",
            "text": "L'osmoseur se pose sous l'évier sans plombier, j'ai suivi la notice tranquillement. L'eau a vraiment meilleur goût, on ne rachète plus de packs. J'ai écrit avant de commander pour être sûre du modèle, réponse claire et rapide.",
            "author": "Claire M.",
            "date_text": "Il y a 3 jours"
          }
        },
        "review_e8kaEg": {
          "type": "review",
          "settings": {
            "rating": 5,
            "verified": true,
            "title": "Ma peau la remercie",
            "text": "Le filtre de douche se visse en deux minutes. Moins de sensation de tiraillement après la douche et l'eau sent moins le chlore. Pour le prix, franchement rien à redire.",
            "author": "Karim B.",
            "date_text": "Il y a 1 semaine"
          }
        },
        "review_xtJ4Rq": {
          "type": "review",
          "settings": {
            "rating": 4,
            "verified": true,
            "title": "Bon conseil, pas de blabla",
            "text": "J'hésitais entre une carafe et un osmoseur. On m'a orienté vers la carafe pour commencer, sans me pousser au produit le plus cher. Livraison dans les temps. Je repasserai commande pour les recharges.",
            "author": "Bernard L.",
            "date_text": "Il y a 2 semaines"
          }
        }
      },
