                "heading_tag": "p",
                "heading_style": "paragraph",
                "open_by_default": false,
                "icon": "none",
                "icon_custom": "",
                "additional_class": ""
              },
              "blocks": {
                "t": {
                  "type": "text",
                  "settings": {
                    "show_on_display": "desktop_and_mobile",
                    "text": "<p>La référence, la disponibilité et le prix des consommables varient selon le produit. Lorsqu’ils ne sont pas documentés, notre service client les confirme avant la commande.</p>",
                    "text_style": "paragraph",
