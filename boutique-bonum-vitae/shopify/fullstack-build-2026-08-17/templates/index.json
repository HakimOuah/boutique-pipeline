            },
            "q3": {
              "type": "_accordion",
              "settings": {
                "show_on_display": "desktop_and_mobile",
                "heading": "Puis-je retourner un produit ?",
                "heading_tag": "p",
                "heading_style": "paragraph",
                "open_by_default": false,
                "icon": "none",
                "icon_custom": "",
                "additional_class": ""
              },
              "blocks": {
                "t": {
                  "type": "text",
                  "settings": {
                    "show_on_display": "desktop_and_mobile",
                    "text": "<p>Oui. Vous disposez du droit de rétractation légal de 14 jours après réception, sans justification. Contactez notre service client pour organiser le retour ; le remboursement intervient après réception du produit.</p>",
                    "text_style": "paragraph",
                    "paragraph_font_size": "normal",
                    "font_weight": 400,
                    "alignment": "left",
                    "alignment_mobile": "left",
                    "show_read_more": false,
