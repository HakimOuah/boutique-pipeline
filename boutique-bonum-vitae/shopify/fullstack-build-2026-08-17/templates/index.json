              "block_order": [
                "t"
              ]
            },
            "q2": {
              "type": "_accordion",
              "settings": {
                "show_on_display": "desktop_and_mobile",
                "heading": "Quels sont les délais de livraison ?",
                "heading_tag": "p",
                "heading_style": "paragraph",
                "open_by_default": false,
                "icon": "none",
                "icon_custom": "",
                "additional_class": ""
              },
              "blocks": {
                "t": {
                  "type": "text",
                  "settings": {
                    "show_on_display": "desktop_and_mobile",
                    "text": "<p>Les commandes sont préparées et expédiées sous 24 à 48 h (hors week-ends et jours fériés). Délai total estimé : 6 à 10 jours ouvrés, livraison offerte et suivie en France.</p>",
                    "text_style": "paragraph",
                    "paragraph_font_size": "normal",
                    "font_weight": 400,
                    "alignment": "left",
                    "alignment_mobile": "left",
                    "show_read_more": false,
                    "read_more_length": 50,
