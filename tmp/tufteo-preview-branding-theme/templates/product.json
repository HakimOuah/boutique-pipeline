            "custom_liquid": "<style>\n.trust-blocks {\n  width: 100%;\n  margin: 0;\n  padding: 0;\n}\n.trust-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 8px;\n  margin-bottom: 8px;\n}\n.trust-card {\n  background: #FDF8EF;\n  border: 1px solid #1C1410;\n  border-radius: 12px;\n  padding: 16px 8px;\n  text-align: center;\n}\n.trust-icon {\n  width: 40px;\n  height: 40px;\n  margin: 0 auto 8px;\n  background: #1C1410;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.trust-icon svg {\n  width: 20px;\n  height: 20px;\n  stroke: #ffffff;\n  fill: none;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n.trust-title {\n  font-family: var(--font-body--family, var(--font-body-family, 'Inter', sans-serif));\n  font-size: 8.5px;\n  font-weight: 700;\n  color: #1C1410;\n  margin: 0;\n  line-height: 1.2;\n  text-transform: uppercase;\n  letter-spacing: 0.01em;\n}\n.contact-block {\n  background: #FDF8EF;\n  border: 1px solid #1C1410;\n  border-radius: 12px;\n  padding: 16px;\n  text-align: left;\n}\n.contact-block p {\n  font-family: var(--font-body--family, var(--font-body-family, 'Inter', sans-serif));\n  font-size: 13px;\n  color: #5A4A40;\n  margin: 0;\n  line-height: 1.5;\n}\n.contact-block a {\n  color: #1C1410;\n  text-decoration: none;\n  font-weight: 600;\n}\n.contact-block a:hover {\n  text-decoration: underline;\n}\n</style>\n<div class=\"trust-blocks\">\n  <div class=\"trust-grid\">\n    <div class=\"trust-card\">\n      <div class=\"trust-icon\">\n        <svg viewBox=\"0 0 24 24\">\n          <rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"></rect>\n          <path d=\"M16 8h5l3 3v5h-2\"></path>\n          <circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle>\n          <circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle>\n        </svg>\n      </div>\n      <h3 class=\"trust-title\">LIVRAISON OFFERTE<br>EN FRANCE</h3>\n    </div>\n    <div class=\"trust-card\">