        "composition": {
          "type": "custom-code",
          "settings": {
            "show_on_display": "desktop_and_mobile",
            "custom_liquid": "{% liquid\nassign has_compo = false\nfor v in product.variants\n  if v.metafields.custom.composition.value != blank\n    assign has_compo = true\n  endif\nendfor\n%}\n{% if has_compo %}\n<style>\n.tuf-compo { background: #FDF8EF; border: 1px solid #1C1410; border-radius: 12px; padding: 16px; }\n.tuf-compo-title { font-weight: 700; color: #1C1410; font-size: 14px; margin: 0 0 8px; }\n.tuf-compo ul { margin: 0; padding-left: 18px; color: #5A4A40; font-size: 13px; line-height: 1.6; }\n.tuf-compo-note { font-size: 11px; color: #8a7a6f; margin: 10px 0 0; }\n</style>\n<div class=\"tuf-compo\" id=\"tuf-compo\" style=\"display:none\">\n  <p class=\"tuf-compo-title\">Ce que contient « <span id=\"tuf-compo-name\"></span> »</p>\n  <ul id=\"tuf-compo-list\"></ul>\n  <p class=\"tuf-compo-note\">Contenu annoncé par le fournisseur.</p>\n</div>\n<script>\n(function () {\n  var DATA = {\n    {% for v in product.variants %}\"{{ v.id }}\": { \"n\": {{ v.title | json }}, \"c\": {{ v.metafields.custom.composition.value | default: \"\" | json }} }{% unless forloop.last %},{% endunless %}{% endfor %}\n  };\n  var box = document.getElementById('tuf-compo');\n  if (!box) return;\n  var last = null;\n  function pick() {\n    var p = new URLSearchParams(location.search).get('variant');\n    if (p && DATA[p]) return p;\n    return String({{ product.selected_or_first_available_variant.id }});\n  }\n  function render() {\n    var id = String(pick());\n    if (id === last) return;\n    last = id;\n    var d = DATA[id];\n    if (!d || !d.c) { box.style.display = 'none'; return; }\n    var nm = (d.n === 'Default Title') ? 'ton kit' : d.n;\n    document.getElementById('tuf-compo-name').textContent = nm;\n    var ul = document.getElementById('tuf-compo-list');\n    ul.innerHTML = '';\n    d.c.split('\\n').forEach(function (line) {\n      if (line.trim()) {\n        var li = document.createElement('li');\n        li.textContent = line;\n        ul.appendChild(li);\n      }\n    });\n    box.style.display = 'block';\n  }\n  render();\n  setInterval(render, 400);\n})();\n</script>\n{% endif %}",
