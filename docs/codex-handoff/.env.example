# =============================================================================
# .env.example — dossier de passation Codex (2026-07-30)
# AUCUNE valeur réelle ici. Copier en `.env` (jamais commité — déjà dans .gitignore)
# et remplir depuis le gestionnaire de mots de passe / les admins des services.
# =============================================================================

# --- Shopify — Maison Noirmont (v42pzp-h4.myshopify.com / maisonnoirmont.fr) ---
# Créer une app custom : Admin > Settings > Apps and sales channels > Develop apps.
# Scopes constatés nécessaires : read/write products, themes (brouillon only),
# publications, files, metafields.
SHOPIFY_NOIRMONT_STORE_DOMAIN=v42pzp-h4.myshopify.com
SHOPIFY_NOIRMONT_ADMIN_TOKEN=            # token Admin API de l'app custom (shpat_…)
SHOPIFY_NOIRMONT_API_VERSION=            # ex. 2026-07

# --- Shopify — Tuftéo (domaine vérifié publiquement le 2026-07-30) ---
SHOPIFY_TUFTEO_STORE_DOMAIN=et0hua-w1.myshopify.com
SHOPIFY_TUFTEO_ADMIN_TOKEN=
SHOPIFY_TUFTEO_API_VERSION=

# NB : le mot de passe storefront (vitrine « ouverture prochaine ») se lit dans
# Admin > Online Store > Preferences. Ne jamais l'écrire dans un fichier du dépôt.

# --- Notion (workspace OH VENTURES — dashboard uniquement, jamais source de vérité) ---
NOTION_API_TOKEN=                        # token d'intégration interne à créer
NOTION_DB_RECHERCHES_PRODUIT=b23a48625ace4704980659f165bb0ec6
NOTION_DB_BOUTIQUES=3a26f4af523d448a907fce7b45b42bcc

# --- Trustoo (import d'avis, app Shopify par boutique) ---
TRUSTOO_API_KEY=                         # visible dans l'app Trustoo de la boutique

# --- Brand Search (idéation) — MCP côté Claude ; clé API si Codex y accède en direct ---
BRANDSEARCH_API_KEY=                     # quota 10 000 requêtes/mois, à surveiller

# --- SEMrush (compte payant, accès par session navigateur ; API non utilisée à ce jour) ---
SEMRUSH_API_KEY=                         # seulement si un accès API est souscrit

# --- Higgsfield (visuels IA — via connecteur MCP aujourd'hui) ---
HIGGSFIELD_API_KEY=

# --- Dropilot (prototype de pipeline batch — voir docs/OPERATIONS.md, docs/HERMES-VPS.md) ---
BIGBUY_API_KEY=                          # sandbox par défaut ; prod via --base-url
DROPILOT_WEBHOOK_TOKEN=                  # long secret aléatoire (Bearer du webhook local)
DROPILOT_DB=data/dropilot.sqlite3
DROPILOT_INBOX=data/inbox
DROPILOT_REPORTS=reports
DROPILOT_CONFIG=config/pipeline.yaml
DROPILOT_PORT=8787
