  margin-bottom: 8px;
}
.trust-card {
  background: #F7F4EE;
  border: 1px solid #0E3A5A;
  border-radius: 12px;
  padding: 16px 8px;
  text-align: center;
}
.trust-icon {
  width: 40px;
