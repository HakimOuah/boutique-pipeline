  align-items: center;
  justify-content: center;
}
.trust-icon svg {
  width: 20px;
  height: 20px;
  stroke: #ffffff;
  fill: none;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.trust-title {
  font-family: var(--font-body--family, var(--font-body-family, 'Inter', sans-serif));
  font-size: 8.5px;
  font-weight: 700;
  color: #0E3A5A;
  margin: 0;
  line-height: 1.2;
  text-transform: uppercase;
  letter-spacing: 0.01em;
}
.contact-block {
  background: #F7F4EE;
  border: 1px solid #0E3A5A;
  border-radius: 12px;
  padding: 16px;
  text-align: left;
}
.contact-block p {
