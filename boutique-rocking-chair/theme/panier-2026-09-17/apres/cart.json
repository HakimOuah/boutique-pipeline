{
  "sections": {
    "main": {
      "type": "cart",
      "blocks": {
        "cart_header_blocks": {
          "type": "_cart-header-blocks",
          "static": true,
          "settings": {
            "wrap_in_card": true,
            "color_scheme": "scheme-2",
            "margin_top": 15,
            "margin_bottom": 0
          },
          "blocks": {
            "banner_franco": {
              "type": "custom-code",
              "settings": {
                "show_on_display": "desktop_and_mobile",
                "custom_liquid": "<div class=\"bc-cart-banner\">\n  <svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 7h11v9H3z\"/><path d=\"M14 10h4l3 3v3h-7z\"/><circle cx=\"7\" cy=\"17.5\" r=\"1.6\"/><circle cx=\"17\" cy=\"17.5\" r=\"1.6\"/></svg>\n  <span>Livraison offerte en France métropolitaine, avec suivi</span>\n</div>\n<style>\n  .bc-cart-banner{display:flex;align-items:center;justify-content:center;gap:.5rem;margin:0 0 12px;padding:.7rem 1rem;border-radius:14px;background:#1E2A3A;color:#F7F2EA;font-size:.85rem;font-weight:600;text-align:center;box-shadow:inset 3px 0 0 #E08E45}\n  .bc-cart-banner svg{flex:none;color:#E08E45}\n</style>",
                "margin_top": 0,
                "margin_bottom": 0,
                "additional_class": ""
              },
              "blocks": {},
              "name": "Bannière livraison"
            }
          },
          "block_order": [
            "banner_franco"
          ]
        },
        "cart_footer_resume_blocks": {
          "type": "_cart-footer-resume-blocks",
          "static": true,
          "settings": {
            "wrap_in_card": false,
            "color_scheme": "",
            "margin_top": 0,
            "margin_bottom": 0
          },
          "blocks": {
            "discount_code_3WJdxK": {
              "type": "_discount-code",
              "name": "t:discount_code",
              "settings": {
                "style": "normal",
                "accordion_heading": "Ajouter un code de réduction",
                "button_text": "Appliquer",
                "placeholder": "Code de réduction",
                "margin_top": 0,
                "margin_bottom": 10,
                "additional_class": ""
              },
              "blocks": {}
            },
            "upsell_pieces": {
              "type": "custom-code",
              "settings": {
                "show_on_display": "desktop_and_mobile",
                "custom_liquid": "<div class=\"bc-cart-upsell\">\n{%- liquid\n  assign bc_upsell = 'plaid-pour-fauteuil,table-d-appoint-en-c-a-roulettes,repose-pieds-cube-lin-creme-poche,plaid-fausse-fourrure-effet-lapin' | split: ','\n  assign bc_count = 0\n-%}\n  <p class=\"bc-cart-upsell__title\">Pour compléter votre coin cocon</p>\n  <div class=\"bc-cart-upsell__list\">\n{%- for h in bc_upsell -%}\n  {%- if bc_count >= 2 -%}{%- break -%}{%- endif -%}\n  {%- assign p = all_products[h] -%}\n  {%- if p != empty and p.available -%}\n    {%- assign in_cart = false -%}\n    {%- for item in cart.items -%}\n      {%- if item.product.handle == h -%}{%- assign in_cart = true -%}{%- endif -%}\n    {%- endfor -%}\n    {%- unless in_cart -%}\n      {%- assign v = p.selected_or_first_available_variant -%}\n      <div class=\"bc-cart-upsell__item\">\n        <a href=\"{{ p.url }}\" class=\"bc-cart-upsell__media\">\n          <img src=\"{{ p.featured_image | image_url: width: 160 }}\" alt=\"{{ p.title | escape }}\" width=\"56\" height=\"56\" loading=\"lazy\">\n        </a>\n        <div class=\"bc-cart-upsell__info\">\n          <a href=\"{{ p.url }}\" class=\"bc-cart-upsell__name\">{{ p.title }}</a>\n          <div class=\"bc-cart-upsell__row\">\n            <span class=\"bc-cart-upsell__price\">{{ v.price | money }}</span>\n            <button type=\"button\" class=\"bc-upsell-add\" data-variant-id=\"{{ v.id }}\">Ajouter</button>\n          </div>\n        </div>\n      </div>\n      {%- assign bc_count = bc_count | plus: 1 -%}\n    {%- endunless -%}\n  {%- endif -%}\n{%- endfor -%}\n  </div>\n</div>\n<style>\n  .bc-cart-upsell{margin:0 0 12px}\n  .bc-cart-upsell__title{font-family:var(--font-heading--family,serif);color:#1E2A3A;font-size:1.05rem;margin:0 0 .8rem}\n  .bc-cart-upsell__list{display:flex;flex-direction:column;gap:.9rem}\n  .bc-cart-upsell__item{display:grid;grid-template-columns:56px 1fr;align-items:center;gap:.75rem}\n  .bc-cart-upsell__media{display:block}\n  .bc-cart-upsell__item img{width:56px;height:56px;object-fit:cover;border-radius:10px;background:#F7F2EA;display:block}\n  .bc-cart-upsell__info{display:flex;flex-direction:column;gap:.35rem;min-width:0}\n  .bc-cart-upsell__name{font-size:.85rem;line-height:1.25;color:#1E2A3A;text-decoration:none}\n  .bc-cart-upsell__row{display:flex;align-items:center;justify-content:space-between;gap:.5rem}\n  .bc-cart-upsell__price{font-size:.9rem;font-weight:600;color:#1E2A3A;white-space:nowrap}\n  .bc-upsell-add{border:0;cursor:pointer;background:#1E2A3A;color:#F7F2EA;font-size:.78rem;font-weight:600;padding:.4rem .85rem;border-radius:999px;white-space:nowrap}\n  .bc-upsell-add:hover{background:#AE5420;color:#FFFFFF}\n</style>\n<script>\n(function(){\n  document.addEventListener('click', function(e){\n    var btn = e.target.closest('.bc-upsell-add');\n    if(!btn) return;\n    e.preventDefault();\n    var id = parseInt(btn.getAttribute('data-variant-id'), 10);\n    if(!id) return;\n    btn.disabled = true;\n    fetch('/cart/add.js', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({id:id, quantity:1})})\n      .then(function(r){ if(!r.ok) throw r; location.reload(); })\n      .catch(function(){ btn.disabled = false; });\n  });\n})();\n</script>",
                "margin_top": 0,
                "margin_bottom": 10,
                "additional_class": ""
              },
              "blocks": {},
              "name": "Suggestions accessoires"
            }
          },
