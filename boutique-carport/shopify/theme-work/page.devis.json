  "formulaire": {
   "type": "custom-section",
   "blocks": {
    "h2": {
     "type": "text",
     "settings": {
      "show_on_display": "desktop_and_mobile",
      "text": "<h2>Demander mon devis gratuit</h2>",
      "text_style": "h3",
      "paragraph_font_size": "normal",
      "font_weight": 400,
      "alignment": "left",
      "alignment_mobile": "left",
      "show_read_more": false,
      "read_more_length": 50,
      "read_more_text": "Voir plus",
      "read_less_text": "Voir moins",
      "truncate": false,
      "truncate_length": 2,
      "margin_top": 0,
      "margin_bottom": 10,
      "additional_class": ""
     },
     "blocks": {}
    },
    "intro": {
     "type": "text",
     "settings": {
      "show_on_display": "desktop_and_mobile",
      "text": "<p>Vous nous donnez les cotes, nous vous envoyons un prix ferme sous 48 h ouvrées, sans engagement.</p>",
      "text_style": "paragraph",
      "paragraph_font_size": "normal",
      "font_weight": 400,
      "alignment": "left",
      "alignment_mobile": "left",
      "show_read_more": false,
      "read_more_length": 50,
      "read_more_text": "Voir plus",
      "read_less_text": "Voir moins",
      "truncate": false,
      "truncate_length": 2,
      "margin_top": 0,
      "margin_bottom": 0,
      "additional_class": ""
     },
     "blocks": {}
    },
    "form": {
     "type": "custom-code",
     "settings": {
      "show_on_display": "desktop_and_mobile",
      "custom_liquid": "<div class=\"sa-form\">{% form 'contact', id: 'FormDevisSousAbri' %}{% if form.posted_successfully? %}<p class=\"sa-form__ok\">Demande envoyée. Réponse sous 48 h ouvrées avec un prix ferme.</p>{% endif %}<input type=\"hidden\" name=\"contact[Page]\" value=\"{{ closest.page.title }}\"><div class=\"sa-form__row\"><div><label for=\"DevisLongueur\">Longueur souhaitée (m)</label><input type=\"text\" id=\"DevisLongueur\" name=\"contact[Longueur (m)]\" required></div><div><label for=\"DevisLargeur\">Largeur souhaitée (m)</label><input type=\"text\" id=\"DevisLargeur\" name=\"contact[Largeur (m)]\" required></div><div><label for=\"DevisHauteur\">Hauteur de passage souhaitée (m)</label><input type=\"text\" id=\"DevisHauteur\" name=\"contact[Hauteur de passage (m)]\"></div></div><div class=\"sa-form__row\"><div><label for=\"DevisVoitures\">Nombre de voitures</label><select id=\"DevisVoitures\" name=\"contact[Nombre de voitures]\"><option>1 voiture</option><option>2 voitures</option></select></div><div><label for=\"DevisConfig\">Configuration</label><select id=\"DevisConfig\" name=\"contact[Configuration]\"><option>Adossé (contre un mur)</option><option>Autoportant</option></select></div></div><div class=\"sa-form__row\"><div><label for=\"DevisToit\">Type de toit</label><select id=\"DevisToit\" name=\"contact[Type de toit]\"><option>Toit plat</option><option>Monopente</option><option>Cintré</option></select></div><div><label for=\"DevisToiture\">Toiture</label><select id=\"DevisToiture\" name=\"contact[Toiture]\"><option>Polycarbonate transparent</option><option>Polycarbonate teinté</option><option>Polycarbonate opaque</option></select></div></div><div class=\"sa-form__row\"><div><label for=\"DevisColoris\">Coloris de la structure</label><input type=\"text\" id=\"DevisColoris\" name=\"contact[Coloris]\" placeholder=\"Anthracite, blanc, autre\"></div><div><label for=\"DevisSol\">Nature du sol</label><select id=\"DevisSol\" name=\"contact[Nature du sol]\"><option>Terre</option><option>Dalle béton</option><option>Enrobé</option><option>Autre</option></select></div></div><div class=\"sa-form__row\"><div><label for=\"DevisCP\">Code postal</label><input type=\"text\" id=\"DevisCP\" name=\"contact[Code postal]\" required></div><div><label for=\"DevisEmail\">E-mail</label><input type=\"email\" id=\"DevisEmail\" name=\"contact[email]\" required></div></div><label for=\"DevisTel\">Téléphone</label><input type=\"tel\" id=\"DevisTel\" name=\"contact[Telephone]\"><label class=\"sa-form__checkbox\"><input type=\"checkbox\" name=\"contact[Demarches mairie confirmees]\" value=\"Oui, j'ai lu que ce carport nécessite en général une déclaration préalable en mairie\" required> J'ai lu que ce carport nécessite en général une déclaration préalable en mairie</label><button type=\"submit\" class=\"button\">Demander mon devis gratuit</button>{% endform %}</div>",
      "margin_top": 0,
      "margin_bottom": 0,
      "additional_class": ""
     },
     "blocks": {}
    },
    "note": {
     "type": "text",
     "settings": {
      "show_on_display": "desktop_and_mobile",
      "text": "<p><em>Réponse sous 48 h ouvrées avec un prix ferme, livraison en France métropolitaine (Corse comprise) incluse, et le rappel des démarches à faire en mairie pour vos dimensions. Aucun paiement à cette étape.</em></p>",
      "text_style": "paragraph",
      "paragraph_font_size": "small",
      "font_weight": 400,
      "alignment": "left",
      "alignment_mobile": "left",
      "show_read_more": false,
      "read_more_length": 50,
      "read_more_text": "Voir plus",
      "read_less_text": "Voir moins",
      "truncate": false,
      "truncate_length": 2,
      "margin_top": 0,
      "margin_bottom": 0,
      "additional_class": ""
     },
     "blocks": {}
    }
   },
