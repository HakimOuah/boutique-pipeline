{% comment %}
  Sous Abri — customer reviews carousel (native scroll-snap, no app).
  Adapted from Cosy Cat House's cch-reviews section (parc FullStack).
  IMPORTANT : aucun avis, aucune note, aucun chiffre n'est codé en dur ici.
  Les avis sont une chasse gardée de Hakim : cette section reste SANS bloc "review"
  tant qu'il n'a pas validé et ajouté du contenu réel (via l'éditeur de thème Shopify).
{% endcomment %}
{%- liquid
  assign align = section.settings.heading_alignment
-%}
<style>
  #sa-reviews-{{ section.id }} {
    --sa-stars: {{ section.settings.stars_color }};
    --sa-cardbg: {{ section.settings.card_background }};
    --sa-border: {{ section.settings.card_border }};
    --sa-title: {{ section.settings.title_color }};
    --sa-text: {{ section.settings.text_color }};
    --sa-cards: {{ section.settings.cards }};
    {% if section.settings.background != blank %}background: {{ section.settings.background }};{% endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #sa-reviews-{{ section.id }} .sar__inner { max-width: 1300px; margin: 0 auto; padding-inline: 20px; }
  #sa-reviews-{{ section.id }} .sar__head { display:flex; align-items:flex-end; justify-content:space-between; gap:16px; flex-wrap:wrap; margin: 0 0 22px; }
  #sa-reviews-{{ section.id }} .sar__heading {
    font-family: var(--font-heading--family, serif);
    color: {{ section.settings.heading_color }}; font-size: clamp(24px, 3vw, 34px); line-height: 1.12;
    margin: 0; text-align: {{ align }};
  }
  #sa-reviews-{{ section.id }} .sar__summary { color: {{ section.settings.heading_color }}; font-size: 15px; display:flex; align-items:center; gap:8px; }
  #sa-reviews-{{ section.id }} .sar__viewport { position: relative; }
  #sa-reviews-{{ section.id }} .sar__track {
    display: flex; gap: 16px; list-style: none; margin: 0; padding: 4px 2px 8px;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  #sa-reviews-{{ section.id }} .sar__track::-webkit-scrollbar { display: none; }
  #sa-reviews-{{ section.id }} .sar__card {
    flex: 0 0 calc((100% - (var(--sa-cards) - 1) * 16px) / var(--sa-cards));
    scroll-snap-align: start; box-sizing: border-box;
    background: var(--sa-cardbg); border: 1px solid var(--sa-border); border-radius: 14px;
    padding: 20px; box-shadow: 0 2px 10px rgba(27, 31, 36, 0.06);
    display: flex; flex-direction: column;
    font-family: var(--font-body--family, sans-serif);
  }
  #sa-reviews-{{ section.id }} .sar__top { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
  #sa-reviews-{{ section.id }} .sa-stars { display: inline-flex; gap: 3px; }
  #sa-reviews-{{ section.id }} .sa-star { width: 22px; height: 22px; border-radius: 4px; background: #e6e6e6; display: inline-flex; align-items: center; justify-content: center; }
  #sa-reviews-{{ section.id }} .sa-star.is-on { background: var(--sa-stars); }
  #sa-reviews-{{ section.id }} .sa-star svg { width: 14px; height: 14px; fill: #fff; }
  #sa-reviews-{{ section.id }} .sa-verified { display: inline-flex; align-items: center; gap: 5px; margin-left: auto; font-size: 12px; color: #6b7280; white-space: nowrap; }
  #sa-reviews-{{ section.id }} .sa-verified__dot { width: 16px; height: 16px; border-radius: 50%; background: #9aa4ad; display: inline-flex; align-items: center; justify-content: center; }
  #sa-reviews-{{ section.id }} .sa-verified__dot svg { width: 9px; height: 9px; stroke: #fff; fill: none; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  #sa-reviews-{{ section.id }} .sar__title { font-weight: 700; color: var(--sa-title); font-size: 15px; margin: 0 0 6px; line-height: 1.25; }
  #sa-reviews-{{ section.id }} .sar__text { color: var(--sa-text); font-size: 14px; line-height: 1.55; margin: 0 0 14px; }
  #sa-reviews-{{ section.id }} .sar__meta { color: var(--sa-text); font-size: 13px; margin: auto 0 0; }
  #sa-reviews-{{ section.id }} .sar__meta strong { color: var(--sa-title); font-weight: 600; }
  #sa-reviews-{{ section.id }} .sar__nav { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--sa-border); background: #fff; color: var(--sa-title); font-size: 22px; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(27,31,36,.12); }
  #sa-reviews-{{ section.id }} .sar__nav:hover { background: var(--sa-title); color: #fff; }
  #sa-reviews-{{ section.id }} .sar__nav--prev { left: -8px; }
  #sa-reviews-{{ section.id }} .sar__nav--next { right: -8px; }
  @media (max-width: 749px) {
    #sa-reviews-{{ section.id }} .sar__card { flex-basis: 84%; }
    #sa-reviews-{{ section.id }} .sar__nav { display: none; }
  }
</style>
<div id="sa-reviews-{{ section.id }}" class="sa-reviews"{% if section.settings.anchor_id != blank %} data-anchor="{{ section.settings.anchor_id }}"{% endif %}>
  {% if section.settings.anchor_id != blank %}<span id="{{ section.settings.anchor_id }}"></span>{% endif %}
  <div class="sar__inner">
    <div class="sar__head">
      {%- if section.settings.heading != blank -%}<h2 class="sar__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.summary != blank -%}<div class="sar__summary">{{ section.settings.summary }}</div>{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
    <div class="sar__viewport">
      {%- if section.blocks.size > section.settings.cards -%}
        <button class="sar__nav sar__nav--prev" type="button" aria-label="Précédent" data-dir="-1">&#8249;</button>
      {%- endif -%}
      <ul class="sar__track" role="list">
        {%- for block in section.blocks -%}
          {%- assign r = block.settings.rating -%}
          <li class="sar__card" {{ block.shopify_attributes }}>
            <div class="sar__top">
              <div class="sa-stars" role="img" aria-label="Noté {{ r }} sur 5">
                {%- for i in (1..5) -%}
                  <span class="sa-star{% if i <= r %} is-on{% endif %}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.8 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg></span>
                {%- endfor -%}
              </div>
              {%- if block.settings.verified -%}
                <span class="sa-verified"><span class="sa-verified__dot"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span>Vérifié</span>
              {%- endif -%}
            </div>
            {%- if block.settings.title != blank -%}<p class="sar__title">{{ block.settings.title | escape }}</p>{%- endif -%}
            {%- if block.settings.text != blank -%}<p class="sar__text">{{ block.settings.text | escape | newline_to_br }}</p>{%- endif -%}
            {%- if block.settings.author != blank or block.settings.date_text != blank -%}
              <p class="sar__meta">
                {%- if block.settings.author != blank -%}<strong>{{ block.settings.author | escape }}</strong>{%- endif -%}
                {%- if block.settings.author != blank and block.settings.date_text != blank -%}, {% endif -%}
                {%- if block.settings.date_text != blank -%}{{ block.settings.date_text | escape }}{%- endif -%}
              </p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- if section.blocks.size > section.settings.cards -%}
        <button class="sar__nav sar__nav--next" type="button" aria-label="Suivant" data-dir="1">&#8250;</button>
      {%- endif -%}
    </div>
    {%- endif -%}
  </div>
</div>
<script>
  (function () {
    var root = document.getElementById('sa-reviews-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('.sar__track');
    if (!track) return;
    root.querySelectorAll('.sar__nav').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var card = track.querySelector('.sar__card');
        var step = card ? card.getBoundingClientRect().width + 16 : 320;
        track.scrollBy({ left: step * parseInt(btn.getAttribute('data-dir'), 10), behavior: 'smooth' });
      });
    });
  })();
</script>
{% schema %}
{
  "name": "SA — Avis clients",
  "tag": "section",
  "class": "sa-reviews-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Avis clients" },
    { "type": "html", "id": "summary", "label": "Résumé (HTML) — laisser vide tant qu'aucun avis réel n'est disponible", "default": "" },
    { "type": "select", "id": "heading_alignment", "label": "Alignement du titre", "default": "left", "options": [ { "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centre" } ] },
    { "type": "range", "id": "cards", "label": "Cartes par ligne (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "color", "id": "background", "label": "Fond de la section", "default": "#2F4A5A" },
    { "type": "color", "id": "heading_color", "label": "Couleur du titre", "default": "#F4F1EA" },
    { "type": "color", "id": "card_background", "label": "Fond des cartes", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border", "label": "Bordure des cartes", "default": "#E5E7EB" },
    { "type": "color", "id": "title_color", "label": "Couleur du titre d'avis", "default": "#1B1F24" },
    { "type": "color", "id": "text_color", "label": "Couleur du texte d'avis", "default": "#4B5563" },
    { "type": "color", "id": "stars_color", "label": "Couleur des étoiles", "default": "#C8552B" },
    { "type": "range", "id": "padding_top", "label": "Espace en haut", "min": 0, "max": 100, "step": 5, "default": 50, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Espace en bas", "min": 0, "max": 100, "step": 5, "default": 50, "unit": "px" },
    { "type": "text", "id": "anchor_id", "label": "Ancre" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "range", "id": "rating", "label": "Note", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "checkbox", "id": "verified", "label": "Afficher « Vérifié »", "default": true },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text", "label": "Texte" },
        { "type": "text", "id": "author", "label": "Auteur" },
        { "type": "text", "id": "date_text", "label": "Date (texte)" }
      ]
    }
  ],
  "presets": [ { "name": "SA — Avis clients" } ]
}
{% endschema %}
