{
  "name": "t:sections.countdown.name",
  "class": "countdown-timer-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.countdown.settings.header_content.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.countdown.settings.heading.label",
      "info": "t:sections.countdown.settings.heading.info"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "header",
      "content": "t:sections.countdown.settings.header_timer_settings.content"
    },
    {
      "type": "checkbox",
      "id": "enable_loop",
      "label": "t:sections.countdown.settings.enable_loop.label",
      "default": false,
      "info": "t:sections.countdown.settings.enable_loop.info"
    },
    {
      "type": "text",
      "id": "loop_time",
      "label": "t:sections.countdown.settings.loop_time.label",
      "default": "00:00",
      "info": "t:sections.countdown.settings.loop_time.info",
      "placeholder": "23:59"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "t:sections.countdown.settings.end_date.label",
      "info": "t:sections.countdown.settings.end_date.info",
      "placeholder": "2024-12-31 23:59"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "t:sections.countdown.settings.disclaimer.label",
      "info": "t:sections.countdown.settings.disclaimer.info"
    },
    {
      "type": "header",
      "content": "t:sections.countdown.settings.header_section_style.content"
    },
    {
      "type": "checkbox",
      "id": "display_as_card",
      "label": "t:sections.slideshow.settings.display_as_card.label",
      "info": "t:sections.slideshow.settings.display_as_card.info",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "accent-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.margin.margin_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.margin.margin_bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.countdown.name"
    }
  ]
}