{
  "name": "t:sections.testimonials.name",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.testimonials.settings.header_content.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": {
        "en": "Testimonials",
        "fr": "Témoignages"
      },
      "label": "t:sections.testimonials.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "hn",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.hn.label",
      "info": "t:sections.all.hn.info"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:settings_schema.global.settings.text_alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:settings_schema.global.settings.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:settings_schema.global.settings.text_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:settings_schema.global.settings.text_alignment.options__3.label"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "t:sections.testimonials.settings.show_stars.label"
    },
    {
      "type": "color",
      "id": "stars_color",
      "label": "t:sections.testimonials.settings.stars_color.label",
      "default": "#ffd700"
    },
    {
      "type": "checkbox",
      "id": "show_profile_picture",
      "label": "t:sections.testimonials.settings.show_profile_picture.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.testimonials.settings.premium_rating.content",
      "info": "t:sections.testimonials.settings.premium_rating.info"
    },
    {
      "type": "checkbox",
      "id": "enable_premium_rating",
      "label": "t:sections.testimonials.settings.enable_premium_rating.label",
      "default": false
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "t:sections.testimonials.settings.rating_text.label",
      "info": "t:sections.testimonials.settings.rating_text.info",
      "default": "Excellent"
    },
    {
      "type": "text",
      "id": "rating_number",
      "label": "t:sections.testimonials.settings.rating_number.label",
      "info": "t:sections.testimonials.settings.rating_number.info",
      "default": "4.8"
    },
    {
      "type": "header",
      "content": "t:sections.testimonials.settings.header_layout.content"
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_slider",
      "label": "t:sections.testimonials.settings.enable_desktop_slider.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_slider",
      "default": false,
      "label": "t:sections.testimonials.settings.enable_mobile_slider.label"
    },
    {
      "type": "checkbox",
      "id": "enable_auto_slider",
      "default": false,
      "label": "t:sections.testimonials.settings.enable_auto_slider.label",
      "info": "t:sections.testimonials.settings.enable_auto_slider.info"
    },
    {
      "type": "range",
      "id": "auto_slider_delay",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5,
      "label": "t:sections.testimonials.settings.auto_slider_delay.label",
      "info": "t:sections.testimonials.settings.auto_slider_delay.info"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.testimonials.settings.columns_desktop.label"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.testimonials.settings.columns_tablet.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.testimonials.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.testimonials.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.testimonials.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.testimonials.settings.header_navigation.content"
    },
    {
      "type": "checkbox",
      "id": "hide_dots",
      "label": "t:sections.all.slider.hide_dots.label"
    },
    {
      "type": "header",
      "content": "t:sections.testimonials.settings.header_section_style.content"
    },
    {
      "type": "checkbox",
      "id": "display_as_card",
      "label": "t:sections.slideshow.settings.display_as_card.label",
      "info": "t:sections.slideshow.settings.display_as_card.info",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "background-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.margin.margin_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.margin.margin_bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:sections.testimonials.blocks.testimonial.name",
      "settings": [
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label",
          "info": "t:sections.all.colors.has_cards_info",
          "default": "background-1"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "t:sections.testimonials.blocks.testimonial.settings.author_image.label",
          "info": "t:sections.testimonials.blocks.testimonial.settings.author_image.info"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "t:sections.testimonials.blocks.testimonial.settings.author_name.label",
          "default": "John D."
        },
        {
          "type": "text",
          "id": "author_description",
          "label": "t:sections.testimonials.blocks.testimonial.settings.author_description.label",
          "default": {
            "en": "CEO of Company Inc.",
            "fr": "PDG de la société Inc."
          }
        },
        {
          "type": "range",
          "id": "rating",
          "label": "t:sections.testimonials.blocks.testimonial.settings.rating.label",
          "min": 0,
          "max": 5,
          "step": 0.5,
          "default": 5,
          "info": "t:sections.testimonials.blocks.testimonial.settings.rating.info"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.testimonials.blocks.testimonial.settings.content.label",
          "default": {
            "en": "<p>This is the best theme I've ever used!</p>",
            "fr": "<p>C'est le meilleur thème que j'ai jamais utilisé !</p>"
          }
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.presets.name",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}