{
  "name": "t:sections.logo-list.name",
  "tag": "section",
  "class": "section-logo-list",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.logo-list.settings.header_content.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.logo-list.settings.heading.label",
      "default": {
        "en": "As Seen On",
        "fr": "Ils Nous Font Confiance"
      }
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "hn",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.hn.label",
      "info": "t:sections.all.hn.info"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:settings_schema.global.settings.text_alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:settings_schema.global.settings.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:settings_schema.global.settings.text_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:settings_schema.global.settings.text_alignment.options__3.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.logo-list.settings.header_layout.content"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:sections.logo-list.settings.logo_width.label",
      "min": 100,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "per_row_desktop",
      "label": "t:sections.logo-list.settings.per_row_desktop.label",
      "min": 3,
      "max": 7,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "enable_marquee_desktop",
      "label": "t:sections.logo-list.settings.enable_marquee_desktop.label",
      "default": false
    },
    {
      "type": "range",
      "id": "marquee_speed_desktop",
      "label": "t:sections.logo-list.settings.marquee_speed_desktop.label",
      "min": 5,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 25,
      "info": "t:sections.logo-list.settings.marquee_speed_desktop.info"
    },
    {
      "type": "header",
      "content": "t:sections.logo-list.settings.header_mobile.content"
    },
    {
      "type": "range",
      "id": "per_row_mobile",
      "label": "t:sections.logo-list.settings.per_row_mobile.label",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "enable_marquee_mobile",
      "label": "t:sections.logo-list.settings.enable_marquee_mobile.label",
      "default": false
    },
    {
      "type": "range",
      "id": "marquee_speed_mobile",
      "label": "t:sections.logo-list.settings.marquee_speed_mobile.label",
      "min": 5,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 25,
      "info": "t:sections.logo-list.settings.marquee_speed_mobile.info"
    },
    {
      "type": "header",
      "content": "t:sections.logo-list.settings.header_section_style.content"
    },
    {
      "type": "checkbox",
      "id": "display_as_card",
      "label": "t:sections.slideshow.settings.display_as_card.label",
      "info": "t:sections.slideshow.settings.display_as_card.info",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.margin.margin_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.margin.margin_bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.logo-list.name"
    }
  ]
}