{
  "name": "t:sections.slideshow.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.header_layout.content"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "auto",
          "label": "t:sections.slideshow.settings.height.options__1.label"
        },
        {
          "value": "highest_image",
          "label": "t:sections.slideshow.settings.height.options__2.label"
        },
        {
          "value": "fixed",
          "label": "t:sections.slideshow.settings.height.options__3.label"
        }
      ],
      "default": "auto",
      "label": "t:sections.slideshow.settings.height.label"
    },
    {
      "type": "range",
      "id": "max_height",
      "min": 300,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "t:sections.slideshow.settings.max_height.label",
      "info": "t:sections.slideshow.settings.max_height.info",
      "default": 500
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.header_slider_behavior.content"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement-bar.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 5,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "default": 5
    },
    {
      "type": "select",
      "id": "loading",
      "options": [
        {
          "value": "lazy",
          "label": "t:sections.slideshow.settings.loading.options__1.label"
        },
        {
          "value": "eager",
          "label": "t:sections.slideshow.settings.loading.options__2.label"
        }
      ],
      "default": "eager",
      "label": "t:sections.slideshow.settings.loading.label",
      "info": "t:sections.slideshow.settings.loading.info"
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.header_navigation.content"
    },
    {
      "type": "select",
      "id": "arrow_position_desktop",
      "options": [
        {
          "value": "left",
          "label": "t:sections.slideshow.settings.arrow_position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.slideshow.settings.arrow_position.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.slideshow.settings.arrow_position.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.slideshow.settings.arrow_position_desktop.label"
    },
    {
      "type": "select",
      "id": "arrow_position_mobile",
      "options": [
        {
          "value": "left",
          "label": "t:sections.slideshow.settings.arrow_position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.slideshow.settings.arrow_position.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.slideshow.settings.arrow_position.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.slideshow.settings.arrow_position_mobile.label"
    },
    {
      "type": "color",
      "id": "arrow_color_desktop",
      "label": "t:sections.slideshow.settings.arrow_color_desktop.label",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "arrow_color_mobile",
      "label": "t:sections.slideshow.settings.arrow_color_mobile.label",
