    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.header_mobile.content"
    },
    {
      "type": "checkbox",
      "id": "keep_text_on_media_mobile",
      "label": "t:sections.slideshow.settings.keep_text_on_media_mobile.label",
      "default": false,
      "info": "t:sections.slideshow.settings.keep_text_on_media_mobile.info"
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.header_section_style.content"
