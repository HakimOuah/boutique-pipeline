{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header_slider_behavior.content"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "t:sections.announcement-bar.settings.icon.label",
      "default": "arrow",
      "options": [
        {
          "value": "arrow",
          "label": "t:sections.announcement-bar.settings.icon.options.arrow.label"
        },
        {
          "value": "caret",
          "label": "t:sections.announcement-bar.settings.icon.options.caret.label"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement-bar.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 5,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "marquee",
      "label": "t:sections.announcement-bar.settings.marquee.label",
      "default": false
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.marquee_speed.label",
      "default": 25,
      "info": "t:sections.announcement-bar.settings.marquee_speed.info"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header_section_style.content"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "accent-1"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": {
            "en": "<p><strong>Free delivery</strong> from $70.</p>",
            "fr": "<p><strong>Livraison offerte</strong> dès 70€ d'achat.</p>"
          },
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}