{
  "name": "t:sections.mega-menu.name",
  "disabled_on": {
    "groups": [
      "footer"
    ],
    "templates": [
      "*"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.mega-menu.settings.mega_menu_info.content"
    },
    {
      "type": "header",
      "content": "t:sections.mega-menu.settings.header_section_style.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.mega-menu.settings.color_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.mega-menu.settings.header_configuration.content"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "t:sections.mega-menu.settings.anchor.label",
      "info": "t:sections.mega-menu.settings.anchor.info"
    },
    {
      "type": "header",
      "content": "t:sections.mega-menu.settings.header_layout.content"
    },
    {
      "type": "checkbox",
      "id": "column_border",
      "label": "t:sections.mega-menu.settings.column_border.label"
    },
    {
      "type": "range",
      "id": "column_number",
      "label": "t:sections.mega-menu.settings.column_number.label",
