          "type": "image_picker",
          "id": "image_bottom",
          "label": "t:sections.mega-menu.blocks.column.settings.image_bottom.label"
        },
        {
          "type": "url",
          "id": "image_bottom_link",
          "label": "t:sections.mega-menu.blocks.column.settings.image_bottom_link.label"
