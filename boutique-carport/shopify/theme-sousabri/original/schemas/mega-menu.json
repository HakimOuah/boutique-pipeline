      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:sections.mega-menu.settings.header_images.content"
    },
    {
      "type": "checkbox",
      "id": "display_link_image",
      "label": "t:sections.mega-menu.settings.display_link_image.label",
      "info": "t:sections.mega-menu.settings.display_link_image.info",
      "default": true
    },
    {
      "type": "select",
      "id": "link_image_ratio",
      "label": "t:sections.mega-menu.settings.link_image_ratio.label",
      "options": [
        {
          "value": "1/1",
          "label": "1:1"
        },
        {
          "value": "3/4",
          "label": "3:4"
        },
        {
          "value": "4/3",
          "label": "4:3"
        }
      ],
      "default": "1/1"
    },
    {
      "type": "range",
      "id": "link_image_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0,
      "unit": "px",
      "label": "t:sections.mega-menu.settings.link_image_border_radius.label"
    },
    {
      "type": "range",
      "id": "link_image_size_desktop",
      "min": 32,
      "max": 120,
      "step": 8,
      "default": 40,
      "unit": "px",
      "label": "t:sections.mega-menu.settings.link_image_size_desktop.label"
    },
    {
      "type": "range",
      "id": "link_image_size_mobile",
      "min": 32,
      "max": 120,
      "step": 8,
      "default": 40,
      "unit": "px",
      "label": "t:sections.mega-menu.settings.link_image_size_mobile.label"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "header",
          "content": "t:sections.mega-menu.blocks.column.settings.content_heading"
        },
        {
