          "id": "richtext_top",
          "label": "t:sections.mega-menu.blocks.column.settings.richtext_top.label"
        },
        {
          "type": "image_picker",
          "id": "image_top",
          "label": "t:sections.mega-menu.blocks.column.settings.image_top.label"
        },
        {
