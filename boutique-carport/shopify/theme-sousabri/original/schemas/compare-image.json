{
  "name": "t:sections.compare-image.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.compare-image.settings.header_content.content"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:sections.compare-table.settings.content_position.label",
      "options": [
        {
          "value": "above",
          "label": "t:sections.compare-table.settings.content_position.option_1.label"
        },
        {
          "value": "left",
          "label": "t:sections.compare-table.settings.content_position.option_2.label"
        },
        {
          "value": "right",
          "label": "t:sections.compare-table.settings.content_position.option_3.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.compare-image.settings.heading.label",
      "default": {
        "fr": "Avant & Après",
        "en": "Before & After"
      }
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "hn",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.hn.label",
      "info": "t:sections.all.hn.info"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:sections.compare-image.settings.content.label",
      "default": {
        "en": "<p>Use this section to show before and after images of your work.</p>",
        "fr": "<p>Utilisez cette section pour montrer des images avant et après de votre travail.</p>"
      }
    },
    {
      "type": "header",
      "content": "t:sections.compare-image.settings.header_before.content"
    },
    {
      "type": "text",
      "id": "label_before",
      "label": "t:sections.compare-image.settings.label_before.label",
      "default": {
        "fr": "Avant",
        "en": "Before"
      }
    },
    {
      "type": "image_picker",
      "id": "image_before",
      "label": "t:sections.compare-image.settings.image_before.label"
    },
    {
      "type": "header",
      "content": "t:sections.compare-image.settings.header_after.content"
    },
    {
      "type": "text",
      "id": "label_after",
      "label": "t:sections.compare-image.settings.label_after.label",
      "default": {
        "fr": "Après",
        "en": "After"
      }
    },
    {
      "type": "image_picker",
      "id": "image_after",
      "label": "t:sections.compare-image.settings.image_after.label"
    },
    {
      "type": "header",
      "content": "t:sections.compare-image.settings.header_section_style.content"
    },
    {
      "type": "checkbox",
      "id": "display_as_card",
      "default": false,
      "label": "t:sections.slideshow.settings.display_as_card.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.compare-image.settings.color_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.slideshow.settings.margin_top.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.slideshow.settings.margin_bottom.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.compare-image.presets.name"
    }
  ]
}