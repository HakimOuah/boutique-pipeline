{{- 'component-slideshow.css' | asset_url | stylesheet_tag -}}

<style>
  {% if section.settings.display_as_card %}
    .slideshow-wrapper--{{ section.id }} {
      margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
      margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .slideshow-wrapper--{{ section.id }} {
        margin-top: {{ section.settings.margin_top }}px;
        margin-bottom: {{ section.settings.margin_bottom }}px;
      }
    }
  {% else %}
    #slideshow--{{ section.id }} {
      margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
      margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      #slideshow--{{ section.id }} {
        margin-top: {{ section.settings.margin_top }}px;
        margin-bottom: {{ section.settings.margin_bottom }}px;
      }
    }
  {% endif %}

  {% if section.settings.height == "fixed" %}
    @media (min-width: 750px) {
      #slideshow--{{ section.id }} .slideshow__slider {
        max-height: {{ section.settings.max_height }}px;
      }
    }
  {% endif %}

  {% for block in section.blocks %}
    #slide--{{ block.id }} .slide__image::after {
      background-color: rgba(0, 0, 0, {{ block.settings.image_overlay_opacity | times: 1.0 | divided_by: 100 }})
    }
  {% endfor %}

  {% comment %} OCB: encart blanc derrière le texte de la bannière (lisibilité). Blanc
     forcé pour rester blanc quel que soit le nuancier, scopé à la section (>=750px,
     même périmètre que la box native .slide__content--background). {% endcomment %}
  @media screen and (min-width: 750px) {
    #slideshow--{{ section.id }} .slide__content--background .slide__content-inner {
      background-color: rgb(255, 255, 255);
    }
  }
  #slideshow--{{ section.id }} .slide__content--background-mobile .slide__content-inner {
    background-color: rgb(255, 255, 255);
  }
</style>

{% if section.settings.display_as_card %}
  <div class="page-width">
    <div class="slideshow-wrapper slideshow-wrapper--{{ section.id }} content-container color-{{ section.settings.color_scheme | default: 'background-1' }} gradient">
{% endif %}

<slider-element
  class="slideshow{% if section.settings.hide_dots %} no-dots{% endif %}{% if section.settings.display_as_card %} slideshow--card{% endif %}"
  id="slideshow--{{ section.id }}"
  data-slide-per-view-desktop="1"
  data-slide-per-view-mobile="1"
  data-is-updated-height="true"
  data-is-updated-color="true"
  data-enabled-desktop="true"
  data-enabled-mobile="true"
  {% if section.settings.auto_rotate %}
    data-auto-rotate="{{ section.settings.change_slides_speed | times: 1000 }}"
  {% endif %}
>
  <div class="keen-slider slideshow__slider slideshow__slider--{{ section.settings.height }}{% if section.blocks.size < 2 %} slideshow--single-slide{% endif %}">
    {%- liquid
      comment
        Determine loading strategy based on section position.
        section.index is 1-based, nil in editor/static sections.
        First section gets fetchpriority high + eager loading for LCP.
      endcomment
      if section.index == 1
        assign first_slide_loading = 'eager'
        assign first_slide_fetchpriority = 'high'
      elsif section.index == nil
        assign first_slide_loading = section.settings.loading
        assign first_slide_fetchpriority = nil
      else
        assign first_slide_loading = 'lazy'
        assign first_slide_fetchpriority = nil
      endif
    -%}
    {%- for block in section.blocks -%}
      {%- liquid
        if forloop.first
          assign slide_loading = first_slide_loading
          assign slide_fetchpriority = first_slide_fetchpriority
        else
          assign slide_loading = 'lazy'
          assign slide_fetchpriority = nil
        endif
      -%}
      <div class="keen-slider__slide slideshow__slide{% if section.settings.display_as_card %} slideshow__slide--card{% endif %} color-{{ block.settings.color_scheme }}" {{ block.shopify_attributes }} id="slide--{{ block.id }}">
        {% if block.settings.banner_link != blank %}
          <a href="{{ block.settings.banner_link }}" class="banner__link"></a>
        {% endif %}
        <div class="slide__image{% if block.settings.remove_opacity_mobile %} slide__image--no-overlay-mobile{% endif %}">
          <div class="slide__decoration slide__decoration--{{ block.settings.decoration }}"></div>
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: controls: false, muted: true, loop: true, autoplay: true, class: "slide__image--desktop" }}
          {%- elsif block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 2000 | image_tag: alt: block.settings.heading, loading: slide_loading, fetchpriority: slide_fetchpriority, class: "slide__image--desktop" }}
          {%- else -%}
            {%- assign placeholder_slide = forloop.index | modulo: 2 -%}
            {%- if placeholder_slide == 1 -%}
              {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg slide__image--desktop' }}
            {%- else -%}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg slide__image--desktop' }}
            {%- endif -%}
          {%- endif -%}
          {%- if block.settings.video_mobile != blank -%}
            {{ block.settings.video_mobile | video_tag: controls: false, muted: true, loop: true, autoplay: true, class: "slide__image--mobile" }}
          {%- elsif block.settings.image_mobile != blank -%}
            {{ block.settings.image_mobile | image_url: width: 1200 | image_tag: alt: block.settings.heading, loading: slide_loading, fetchpriority: slide_fetchpriority, class: "slide__image--mobile" }}
          {%- elsif block.settings.video != blank -%}
            {{ block.settings.video | video_tag: controls: false, muted: true, loop: true, autoplay: true, class: "slide__image--mobile" }}
          {%- elsif block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: alt: block.settings.heading, loading: slide_loading, fetchpriority: slide_fetchpriority, class: "slide__image--mobile" }}
          {%- else -%}
            {%- assign placeholder_slide = forloop.index | modulo: 2 -%}
            {%- if placeholder_slide == 1 -%}
              {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg slide__image--mobile' }}
            {%- else -%}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg slide__image--mobile' }}
            {%- endif -%}
          {%- endif -%}
        </div>
        {% if block.settings.heading != blank or block.settings.subheading != blank or block.settings.primary_button_label != blank or block.settings.secondary_button_label != blank %}
          <div class="slide__content sr-animate sr-animate--no-interval {{ block.settings.box_align }}{% if block.settings.show_background %} slide__content--background{% endif %}{% if section.settings.keep_text_on_media_mobile %} slide__content--overlay-mobile mobile-{{ block.settings.box_align_mobile | default: block.settings.box_align }}{% if block.settings.show_background_mobile %} slide__content--background-mobile{% endif %}{% endif %}">
            <div class="{% unless section.settings.display_as_card %}page-width{% endunless %}">
              <div class="slide__content-inner {{ block.settings.text_alignment }} mobile--{{ block.settings.text_alignment_mobile }}" style="border-radius: {{ block.settings.content_border_radius }}px">
                {%- if block.settings.heading != blank -%}
                  <{{ block.settings.hn }} class="slide__heading {{ block.settings.heading_size }}">
                    {{ block.settings.heading }}
                  </{{ block.settings.hn }}>
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  {{- block.settings.subheading -}}
                {%- endif -%}
                {%- if block.settings.primary_button_label != blank or block.settings.secondary_button_label != blank -%}
                  <div class="slide__buttons">
                    {%- if block.settings.primary_button_label != blank -%}
                      <div class="slide__button">
                        <a href="{{- block.settings.primary_button_url -}}" class="button {% if block.settings.primary_secondary_style %}button--secondary{% else %}button--primary{% endif %}">
                          <span>{{- block.settings.primary_button_label -}}</span>
                        </a>
                      </div>
                    {%- endif  -%}
                    {%- if block.settings.secondary_button_label != blank -%}
                      <div class="slide__button">
                        <a href="{{- block.settings.secondary_button_url -}}" class="button {% if block.settings.secondary_secondary_style %}button--secondary{% else %}button--primary{% endif %}">
                          <span>{{- block.settings.secondary_button_label -}}</span>
                        </a>
                      </div>
                    {%- endif  -%}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    {%- endfor -%}
    <div class="slider__navigation">
      <div class="{% unless section.settings.display_as_card %}page-width{% endunless %} slider__navigation--inner {{ section.settings.arrow_position_mobile }}--mobile {{ section.settings.arrow_position_desktop }}--desktop"
        style="--arrow-color-mobile: {{ section.settings.arrow_color_mobile.red }}, {{ section.settings.arrow_color_mobile.green }}, {{ section.settings.arrow_color_mobile.blue }};
              --arrow-color-desktop: {{ section.settings.arrow_color_desktop.red }}, {{ section.settings.arrow_color_desktop.green }}, {{ section.settings.arrow_color_desktop.blue }};"
        >
      </div>
    </div>
  </div>
</slider-element>

{% if section.settings.display_as_card %}
    </div>
  </div>
{% endif %}

{% schema %}
{
