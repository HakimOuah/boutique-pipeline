{{ 'section-reassurance.css' | asset_url | stylesheet_tag }}

{% liquid
	if section.settings.card_style == "text-right"
		assign at_most_columns = 3
		assign columns_mobile = 1
	else
		assign at_most_columns = 4
		assign columns_mobile = section.settings.column_mobile
	endif
%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding .reassurance__grid {
	grid-template-columns: repeat({{ columns_mobile }}, 1fr);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

	.section-{{ section.id }}-padding .reassurance__grid {
		grid-template-columns: repeat({{ section.blocks.size | at_most: at_most_columns }}, 1fr);
	}
  }

  {% if section.settings.display_as_card %}
    .reassurance-wrapper--{{ section.id }} {
      margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
      margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .reassurance-wrapper--{{ section.id }} {
        margin-top: {{ section.settings.margin_top }}px;
        margin-bottom: {{ section.settings.margin_bottom }}px;
      }
    }
  {% else %}
    .reassurance--{{ section.id }} {
      margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
      margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .reassurance--{{ section.id }} {
        margin-top: {{ section.settings.margin_top }}px;
        margin-bottom: {{ section.settings.margin_bottom }}px;
      }
    }
  {% endif %}
{%- endstyle -%}

{% if section.settings.display_as_card %}
  <div class="page-width">
    <div class="reassurance-wrapper reassurance-wrapper--{{ section.id }} content-container content-container--card color-{{ section.settings.color_scheme }} gradient">
{% endif %}

<div class="reassurance reassurance--{{ section.id }} {% unless section.settings.display_as_card %}color-{{ section.settings.color_scheme }} gradient{% endunless %} reassurance--{{ section.settings.card_style }}
    {% if section.settings.card_border %} reassurance--border{% endif %}
    {% if section.settings.card_background %} reassurance--background{% endif %}
    {% unless section.settings.full_width or section.settings.display_as_card %} page-width{% endunless %}"
	style="--card-border-radius: {{ section.settings.card_border_radius }}px;
			--card-background: {{ section.settings.card_background_value }};
			--card-border: {{ section.settings.card_border_value }};
			--card-text-color: {{ section.settings.card_text_color }};"
>
    <div class="reassurance__inner section-{{ section.id }}-padding{% if section.settings.full_width and section.settings.display_as_card == false %} page-width{% endif %}">
		{% if section.settings.heading != blank or section.settings.content != blank %}
			<div class="reassurance__text {{ section.settings.content_alignment }}">
				{% if section.settings.heading != blank %}
					<{{ section.settings.hn }} class="reassurance__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</{{ section.settings.hn }}>
				{% endif %}
				{% if section.settings.content != blank %}
					<div class="reassurance__content rte">
						{{ section.settings.content }}
					</div>
				{% endif %}
			</div>
		{% endif %}
        <div class="reassurance__grid">
            {% for block in section.blocks %}
                <div class="reassurance__item" {{ block.shopify_attributes }}>
                    {% if block.settings.icon != blank %}
                        <div class="reassurance__item-icon">
                            {{ block.settings.icon | image_url: width: 300 | image_tag: loading: 'lazy' }}
                        </div>
                    {% endif %}
					{% if block.settings.heading != blank or block.settings.description != blank %}
						<div class="reassurance__item-content">
							{% if block.settings.heading != blank %}
								<div class="reassurance__item-heading">
									{{ block.settings.heading }}
								</div>
							{% endif %}
							{% if block.settings.description != blank %}
								<div class="reassurance__item-description rte">
									{{ block.settings.description }}
								</div>
							{% endif %}
						</div>
					{% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
</div>

{% if section.settings.display_as_card %}
    </div>
  </div>
{% endif %}

{% schema %}
	{
		"name": "t:sections.reassurance.name",
		"tag": "section",
		"disabled_on": {
			"groups": ["header", "footer"]
		},
		"settings": [
			{
				"type": "header",
				"content": "t:sections.reassurance.settings.header_content.content"
			},
			{
				"type": "select",
				"id": "heading_size",
				"options": [
					{
						"value": "h2",
						"label": "t:sections.all.heading_size.options__1.label"
					},
					{
						"value": "h1",
						"label": "t:sections.all.heading_size.options__2.label"
					},
					{
						"value": "h0",
						"label": "t:sections.all.heading_size.options__3.label"
					}
				],
				"default": "h1",
				"label": "t:sections.all.heading_size.label"
			},
			{
				"type": "select",
				"id": "hn",
				"options": [
					{
						"value": "h1",
						"label": "H1"
					},
					{
						"value": "h2",
						"label": "H2"
					},
					{
						"value": "h3",
						"label": "H3"
					},
					{
						"value": "h4",
						"label": "H4"
					},
					{
						"value": "h5",
						"label": "H5"
					},
					{
						"value": "h6",
						"label": "H6"
					}
				],
				"default": "h2",
				"label": "t:sections.all.hn.label",
				"info": "t:sections.all.hn.info"
			},
			{
				"type": "text",
				"id": "heading",
				"label": "t:sections.reassurance.settings.heading.label",
				"default": {
					"en": "Our guarantees",
					"fr": "Nos guaranties"				
				}
			},
			{
				"type": "richtext",
				"id": "content",
				"label": "t:sections.reassurance.settings.content.label",
				"default": {
					"en": "<p>Texte d'intro</p>",
					"fr": "<p>Intro text</p>"
				}
			},
			{
				"type": "select",
				"id": "content_alignment",
				"options": [
					{
						"value": "left",
						"label": "t:sections.rich-text.settings.content_alignment.options__1.label"
					},
					{
						"value": "center",
						"label": "t:sections.rich-text.settings.content_alignment.options__2.label"
					},
					{
						"value": "right",
						"label": "t:sections.rich-text.settings.content_alignment.options__3.label"
					}
				],
				"default": "center",
				"label": "t:sections.rich-text.settings.content_alignment.label"
			},
			{
				"type": "select",
				"id": "column_mobile",
				"label": "t:sections.reassurance.settings.column_mobile.label",
				"options": [
					{
						"label": "1",
						"value": "1"
					},
					{
						"label": "2",
						"value": "2"
					}
				],
				"default": "2",
				"info": "t:sections.reassurance.settings.column_mobile.info"
			},
            {
                "type": "header",
                "content": "t:sections.reassurance.settings.header_cards.content"
            },
			{
				"type": "select",
				"id": "card_style",
				"label": "t:sections.reassurance.settings.card_style.label",
				"options": [
					{
						"value": "text-below",
						"label": "t:sections.reassurance.settings.card_style.options__1.label"
					},
					{
						"value": "text-right",
						"label": "t:sections.reassurance.settings.card_style.options__2.label"
					}
				],
				"default": "text-below"
			},
            {
                "type": "checkbox",
                "id": "card_background",
                "label": "t:sections.reassurance.settings.card_background.label",
                "default": true
            },
            {
                "type": "color",
                "id": "card_background_value",
                "label": "t:sections.reassurance.settings.card_background_color.label"
            },
            {
                "type": "checkbox",
                "id": "card_border",
                "label": "t:sections.reassurance.settings.card_border.label",
                "default": true
            },
            {
                "type": "color",
                "id": "card_border_value",
                "label": "t:sections.reassurance.settings.card_border_value.label"
            },
			{
                "type": "color",
                "id": "card_text_color",
                "label": "t:sections.reassurance.settings.card_text_color.label",
				"info": "t:sections.reassurance.settings.card_text_color.info"
            },
            {
				"type": "range",
				"id": "card_border_radius",
				"min": 0,
				"max": 50,
				"step": 1,
				"default": 0,
				"unit": "px",
				"label": "t:sections.reassurance.settings.card_border_radius.label"
			},
			{
				"type": "header",
				"content": "t:sections.reassurance.settings.header_section_style.content"
			},
            {
                "type": "checkbox",
                "id": "display_as_card",
                "label": "t:sections.slideshow.settings.display_as_card.label",
                "info": "t:sections.slideshow.settings.display_as_card.info",
                "default": false
            },
			{
				"type": "color_scheme",
				"id": "color_scheme",
				"label": "t:sections.all.colors.label",
				"default": "background-1"
			},
			{
				"type": "range",
				"id": "border_radius",
				"min": 0,
				"max": 50,
				"step": 1,
				"default": 0,
				"unit": "px",
				"label": "t:sections.all.border_radius.label"
			},
			{
                "type": "header",
                "content": "t:sections.all.padding.section_padding_heading"
            },
            {
                "type": "range",
                "id": "margin_top",
                "min": 0,
                "max": 100,
                "step": 4,
                "unit": "px",
                "label": "t:sections.all.margin.margin_top",
                "default": 0
            },
            {
                "type": "range",
                "id": "margin_bottom",
                "min": 0,
                "max": 100,
                "step": 4,
                "unit": "px",
                "label": "t:sections.all.margin.margin_bottom",
                "default": 0
            },
			{
				"type": "range",
				"id": "padding_top",
				"min": 0,
				"max": 100,
				"step": 4,
				"unit": "px",
				"label": "t:sections.all.padding.padding_top",
				"default": 36
			},
			{
				"type": "range",
				"id": "padding_bottom",
				"min": 0,
				"max": 100,
				"step": 4,
				"unit": "px",
				"label": "t:sections.all.padding.padding_bottom",
				"default": 36
			}
		],
		"blocks": [
			{
				"type": "item",
				"name": "t:sections.reassurance.blocks.name",
				"settings": [
                    {
                        "type": "header",
                        "content": "t:sections.reassurance.blocks.settings.header_icon.content"
                    },
                    {
                        "type": "image_picker",
                        "id": "icon",
                        "label": "t:sections.reassurance.blocks.settings.icon.label",
                        "info": "t:sections.reassurance.blocks.settings.icon.info"
                    },
					{
						"type": "text",
						"id": "heading",
						"label": "t:sections.reassurance.blocks.settings.heading.label",
						"default": {
							"en": "Free Delivery",
							"fr": "Livraison gratuite"
						}
					},
                    {
                        "type": "richtext",
                        "id": "description",
                        "label": "t:sections.reassurance.blocks.settings.description.label",
                        "default": "<p>Description</p>"
                    }
				]
			}
		],
		"presets": [
			{
				"name": "t:sections.reassurance.presets.name"
			}
		]
	}
{% endschema %}