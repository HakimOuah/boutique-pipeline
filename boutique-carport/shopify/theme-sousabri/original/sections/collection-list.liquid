{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<style>
  {% if section.settings.display_as_card %}
    .collection-list-wrapper--{{ section.id }} {
      margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
      margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .collection-list-wrapper--{{ section.id }} {
        margin-top: {{ section.settings.margin_top }}px;
        margin-bottom: {{ section.settings.margin_bottom }}px;
      }
    }
  {% else %}
    .section-{{ section.id }}-padding {
      margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
      margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        margin-top: {{ section.settings.margin_top }}px;
        margin-bottom: {{ section.settings.margin_bottom }}px;
      }
    }
  {% endif %}

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .section-{{ section.id }}-padding .card--standard .card__inner:after {
    background-color: rgba(0, 0, 0, {{ section.settings.overlay_opacity | times: 1.0 | divided_by: 100 }})
  }
</style>

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.show_mobile_slider and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif

  assign columns_desktop_int = section.settings.columns_desktop | plus: 0
  assign show_desktop_slider = false
  if section.settings.show_desktop_slider and section.blocks.size > columns_desktop_int
    assign show_desktop_slider = true
  endif
-%}

{% if section.settings.display_as_card %}
  <div class="page-width">
    <div class="collection-list-wrapper collection-list-wrapper--{{ section.id }} content-container content-container--card color-{{ section.settings.color_scheme | default: 'background-1' }} gradient">
      <div class="collection-list-wrapper isolate section-{{ section.id }}-padding" id="CollectionList-{{ section.id }}">
{% else %}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="collection-list-wrapper page-width isolate section-{{ section.id }}-padding" id="CollectionList-{{ section.id }}">
{% endif %}
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link{% if show_mobile_slider %} title-wrapper--self-padded-tablet-down{% else %} title-wrapper--self-padded-mobile{% endif %} title-wrapper--no-top-margin">
        <{{ section.settings.hn }}
          id="SectionHeading-{{ section.id }}"
          class="collection-list-title inline-richtext {{ section.settings.heading_size }}"
        >
          {{ section.settings.title }}
        </{{ section.settings.hn }}>

        {%- if section.settings.show_view_all and show_mobile_slider -%}
          <a
            href="{{ routes.collections_url }}"
            id="ViewAll-{{ section.id }}"
            class="link underlined-link large-up-hide"
            aria-labelledby="ViewAll-{{ section.id }} SectionHeading-{{ section.id }}"
          >
            {{- 'sections.collection_list.view_all' | t -}}
          </a>
        {%- endif -%}
      </div>
    {%- endunless -%}

    <slider-element 
    class="slider-component__show-option{% if section.settings.hide_dots %} no-dots{% endif %}"
      id="featured-collection--{{ section.id }}"
      data-slide-per-view-desktop="{{ section.settings.columns_desktop }}"
      data-slide-per-view-tablet="{{ section.settings.columns_tablet }}"
      data-slide-per-view-mobile="{{ section.settings.columns_mobile }}"
      data-enabled-desktop="{{ show_desktop_slider }}"
      data-enabled-mobile="{{ show_mobile_slider }}"
    >
        <div class="keen-slider grid-slider grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down">
          {%- for block in section.blocks -%}
            <div class="keen-slider__slide grid__item" {{ block.shopify_attributes }}>
              {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
              {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index -%}
              {% render 'card-collection',
                card_collection: block.settings.collection,
                media_aspect_ratio: section.settings.image_ratio,
                columns: columns,
                placeholder_image: placeholder_image,
                title_color: block.settings.title_color,
                collection_heading_size: section.settings.collection_heading_size,
                title_position: section.settings.title_position,
                image: block.settings.image,
                hn: section.settings.card_hn,
                show_collection_title: section.settings.show_collection_title
              %}
            </div>
          {%- endfor -%}
        </div>
        <div class="slider__navigation">
          <div class="slider__navigation--inner {{ section.settings.text_alignment }}">
          </div>
        </div>
    </slider-element>

    {%- if section.settings.show_view_all and section.blocks.size < collections.size -%}
      <div
        class="center collection-list-view-all{% if show_mobile_slider %} small-hide medium-hide{% endif %}"
      >
        <a
          href="{{ routes.collections_url }}"
          class="button"
          id="ViewAllButton-{{ section.id }}"
          aria-labelledby="ViewAllButton-{{ section.id }} SectionHeading-{{ section.id }}"
        >
          <span>{{- 'sections.collection_list.view_all' | t -}}</span>
        </a>
      </div>
    {%- endif -%}
{% if section.settings.display_as_card %}
      </div>
    </div>
  </div>
{% else %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:sections.collection-list.name",
  "tag": "section",
  "class": "section section-collection-list",
  "max_blocks": 15,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.collection-list.settings.header_content.content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Collections",
      "label": "t:sections.collection-list.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "hn",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.hn.label",
      "info": "t:sections.all.hn.info"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": false,
      "label": "t:sections.collection-list.settings.show_view_all.label"
    },
    {
      "type": "header",
      "content": "t:sections.collection-list.settings.header_layout.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.collection-list.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.collection-list.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.collection-list.settings.image_ratio.options__3.label"
        }
      ],
      "default": "square",
      "label": "t:sections.collection-list.settings.image_ratio.label",
      "info": "t:sections.collection-list.settings.image_ratio.info"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "t:sections.collection-list.settings.columns_desktop.label"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.collection-list.settings.columns_tablet.label"
    },
    {
      "type": "checkbox",
      "id": "show_desktop_slider",
      "default": false,
      "label": "t:sections.collection-list.settings.swipe_on_desktop.label"
    },
    {
      "type": "header",
      "content": "t:sections.collection-list.settings.header_collection_cards.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_title",
      "label": "t:sections.collection-list.settings.show_collection_title.label",
      "default": true
    },
    {
      "type": "select",
      "id": "collection_heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "card_hn",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.card_hn.label",
      "info": "t:sections.all.hn.info"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40,
      "label": "t:sections.collection-list.settings.overlay_opacity.label"
    },
    {
      "type": "select",
      "id": "title_position",
      "options": [
        {
          "value": "top-left",
          "label": "t:sections.collection-list.settings.title_position.options__1.label"
        },
        {
          "value": "top-center",
          "label": "t:sections.collection-list.settings.title_position.options__2.label"
        },
        {
          "value": "top-right",
          "label": "t:sections.collection-list.settings.title_position.options__3.label"
        },
        {
          "value": "middle-left",
          "label": "t:sections.collection-list.settings.title_position.options__4.label"
        },
        {
          "value": "middle-center",
          "label": "t:sections.collection-list.settings.title_position.options__5.label"
        },
        {
          "value": "middle-right",
          "label": "t:sections.collection-list.settings.title_position.options__6.label"
        },
        {
          "value": "bottom-left",
          "label": "t:sections.collection-list.settings.title_position.options__7.label"
        },
        {
          "value": "bottom-center",
          "label": "t:sections.collection-list.settings.title_position.options__8.label"
        },
        {
          "value": "bottom-right",
          "label": "t:sections.collection-list.settings.title_position.options__9.label"
        },
        {
          "value": "under",
          "label": "t:sections.collection-list.settings.title_position.options__10.label"
        }
      ],
      "default": "middle-center",
      "label": "t:sections.collection-list.settings.title_position.label",
      "info": "t:sections.collection-list.settings.title_position.info"
    },
    {
