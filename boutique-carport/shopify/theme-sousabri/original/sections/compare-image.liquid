{{ "section-compare-image.css" | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {% if section.settings.display_as_card %}
    .compare-image-wrapper--{{ section.id }} {
      margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
      margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .compare-image-wrapper--{{ section.id }} {
        margin-top: {{ section.settings.margin_top }}px;
        margin-bottom: {{ section.settings.margin_bottom }}px;
      }
    }
  {% else %}
    .compare-image--{{ section.id }} {
      margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
      margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .compare-image--{{ section.id }} {
        margin-top: {{ section.settings.margin_top }}px;
        margin-bottom: {{ section.settings.margin_bottom }}px;
      }
    }
  {% endif %}
{%- endstyle -%}

{%- liquid 
    if section.settings.image_before
      assign image_before = section.settings.image_before | image_url: width: master
    else
      assign image_before = 'placeholder_before.jpg' | asset_url
    endif

    if section.settings.image_after
      assign image_after = section.settings.image_after | image_url: width: master
    else
      assign image_after = 'placeholder_after.jpg' | asset_url
    else
    endif
  -%}

{% if section.settings.display_as_card %}
  <div class="page-width">
    <div class="compare-image-wrapper compare-image-wrapper--{{ section.id }} content-container content-container--card color-{{ section.settings.color_scheme | default: 'background-1' }} gradient">
{% endif %}

<div class="{% unless section.settings.display_as_card %}color-{{ section.settings.color_scheme }} gradient{% endunless %} compare-image--{{ section.id }}">
  <div class="compare-image sr-animate sr-animate--no-interval{% if section.settings.content_position == "center" %} page-width--narrow{% endif %}{% unless section.settings.display_as_card %} compare-image--full-width{% endunless %} 
    section-{{ section.id }}-padding
    content-position--{{ section.settings.content_position }}">
    <div class="compare-image__wrapper{% unless section.settings.display_as_card %} page-width{% endunless %}">
      <div class="compare-image__text">
        {%- if section.settings.heading -%}
          <{{ section.settings.hn }} class="compare-image__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</{{ section.settings.hn }}>
        {%- endif -%}
        {%- if section.settings.content -%}
          <div class="compare-image__content rte">
            {{ section.settings.content }}
          </div>
        {%- endif -%}
      </div>
      <div class="compare-image__compare">
        <div class='image-container'>
          <div class='image-container__img image-container__img--background' style="background-image: url('{{ image_after }}')"></div>
          <div class='image-container__img image-container__img--foreground' style="background-image: url('{{ image_before }}')"></div>
          <input type="range" min="1" max="1000" value="500" class="image-container__slider" id="slider-{{ section.id }}">
          <div class='image-container__slider-button'></div>
        </div>
      </div>
    </div>
  </div>
</div>

{% if section.settings.display_as_card %}
    </div>
  </div>
{% endif %}

{{ 'section-compare-image.js' | asset_url | script_tag }}

{% schema %}
  {
    "name": "t:sections.compare-image.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "header",
        "content": "t:sections.compare-image.settings.header_content.content"
      },
      {
				"type": "select",
				"id": "content_position",
				"label": "t:sections.compare-table.settings.content_position.label",
				"options": [
					{ 
						"value": "above",
						"label": "t:sections.compare-table.settings.content_position.option_1.label" 
					},
					{ 
						"value": "left",
						"label": "t:sections.compare-table.settings.content_position.option_2.label" 
					},
					{ 
						"value": "right", 
						"label": "t:sections.compare-table.settings.content_position.option_3.label"
					}
				],
				"default": "left"
			},
      {
        "type": "text",
        "id": "heading",
        "label": "t:sections.compare-image.settings.heading.label",
        "default": {
          "fr": "Avant & Après",
          "en": "Before & After"
        }
      },
      {
				"type": "select",
				"id": "heading_size",
				"options": [
					{
						"value": "h2",
						"label": "t:sections.all.heading_size.options__1.label"
					},
					{
						"value": "h1",
						"label": "t:sections.all.heading_size.options__2.label"
					},
					{
						"value": "h0",
						"label": "t:sections.all.heading_size.options__3.label"
					}
				],
				"default": "h1",
				"label": "t:sections.all.heading_size.label"
			},
      {
        "type": "select",
        "id": "hn",
        "options": [
          {
            "value": "h1",
            "label": "H1"
          },
          {
            "value": "h2",
            "label": "H2"
          },
          {
            "value": "h3",
            "label": "H3"
          },
          {
            "value": "h4",
            "label": "H4"
          },
          {
            "value": "h5",
            "label": "H5"
          },
          {
            "value": "h6",
            "label": "H6"
          }
        ],
        "default": "h2",
        "label": "t:sections.all.hn.label",
        "info": "t:sections.all.hn.info"
      },
      {
        "type": "richtext",
        "id": "content",
        "label": "t:sections.compare-image.settings.content.label",
        "default": {
          "en":"<p>Use this section to show before and after images of your work.</p>",
          "fr":"<p>Utilisez cette section pour montrer des images avant et après de votre travail.</p>"
        }
      },
      {
        "type": "header",
        "content": "t:sections.compare-image.settings.header_before.content"
      },
      {
        "type": "text",
        "id": "label_before",
        "label": "t:sections.compare-image.settings.label_before.label",
        "default": {
          "fr": "Avant",
          "en": "Before" 
        }
      },
      {
        "type": "image_picker",
        "id": "image_before",
        "label": "t:sections.compare-image.settings.image_before.label"
      },
      {
        "type": "header",
        "content": "t:sections.compare-image.settings.header_after.content"
      },
      {
        "type": "text",
        "id": "label_after",
        "label": "t:sections.compare-image.settings.label_after.label",
        "default": {
          "fr": "Après",
          "en": "After"
        }
      },
      {
        "type": "image_picker",
        "id": "image_after",
        "label": "t:sections.compare-image.settings.image_after.label"
      },
      {
        "type": "header",
        "content": "t:sections.compare-image.settings.header_section_style.content"
      },
      {
        "type": "checkbox",
        "id": "display_as_card",
        "default": false,
        "label": "t:sections.slideshow.settings.display_as_card.label"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.compare-image.settings.color_scheme.label"
      },
      {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      },
      {
        "type": "range",
        "id": "margin_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.slideshow.settings.margin_top.label",
        "default": 0
      },
      {
        "type": "range",
        "id": "margin_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.slideshow.settings.margin_bottom.label",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "presets": [
      {
        "name": "t:sections.compare-image.presets.name"
      }
    ]
  }
{% endschema %}