{{ 'section-faq.css' | asset_url | stylesheet_tag }}


{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {% if section.settings.display_as_card %}
    .faq-wrapper--{{ section.id }} {
      margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
      margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .faq-wrapper--{{ section.id }} {
        margin-top: {{ section.settings.margin_top }}px;
        margin-bottom: {{ section.settings.margin_bottom }}px;
      }
    }
  {% else %}
    .faq--{{ section.id }} {
      margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
      margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .faq--{{ section.id }} {
        margin-top: {{ section.settings.margin_top }}px;
        margin-bottom: {{ section.settings.margin_bottom }}px;
      }
    }
  {% endif %}
{%- endstyle -%}

{% if section.settings.display_as_card %}
  <div class="page-width">
    <div class="faq-wrapper faq-wrapper--{{ section.id }} content-container color-{{ section.settings.color_scheme }} section-card">
{% endif %}

<div class="faq faq--{{ section.id }} sr-animate sr-animate--no-interval section-{{ section.id }}-padding{% unless section.settings.display_as_card %} color-{{ section.settings.color_scheme }}{% endunless %}">
	<div class="{% unless section.settings.display_as_card %}page-width{% endunless %}">
		<div class="faq__header {{ section.settings.text_alignment }}">
			<{{ section.settings.hn }} class="faq__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</{{ section.settings.hn }}>
			<div class="faq__description rte">
				{{ section.settings.description }}
			</div>
		</div>
		{%- for block in section.blocks -%}
			{%- case block.type -%}
				{%- when 'question' -%}
					<collapsible-element {{ block.shopify_attributes }}>
						<h3 class="collapsible__title" {% if block.settings.open_by_default %}active="true"{% endif %}>
							<span class="collapsible__icons">
								{% render "icon-plus" %}
								{% render "icon-minus" %}
							</span>
							{{ block.settings.question }}
						</h3>
						<div class="collapsible__content" {% if block.settings.open_by_default %}active="true"{% endif %}>{{ block.settings.answer }}</div>
					</collapsible-element>
				{%- when 'content' -%}
					<div class="faq__header" {{ block.shopify_attributes }}>
						<{{ block.settings.hn }} class="faq__heading {{ block.settings.heading_size }}">{{ block.settings.heading }}</{{ block.settings.hn }}>
						<div class="faq__description rte">
							{{ block.settings.description }}
						</div>
					</div>
				{%- when 'divider' -%}
					<div class="faq__divider" 
						style="--margin-top: {{ block.settings.margin_top }}px; 
						--margin-bottom: {{ block.settings.margin_bottom }}px" {{ block.shopify_attributes }}>
					</div>
			{%- endcase -%}
		{%- endfor -%}
	</div>
</div>

{% if section.settings.display_as_card %}
    </div>
  </div>
{% endif %}

{% schema %}
	{
		"name": "t:sections.faq.name",
		"tag": "section",
		"class": "section",
		"disabled_on": {
			"groups": ["header", "footer"]
		},
		"settings": [
			{
				"type": "header",
				"content": "t:sections.faq.settings.header_content.content"
			},
			{
				"type": "text",
				"id": "heading",
				"label": "t:sections.faq.settings.heading.label",
				"default": {
					"en": "Frequently Asked Questions",
					"fr": "Foire aux questions"
				}
			},
			{
				"type": "select",
				"id": "heading_size",
				"options": [
					{
						"value": "h2",
						"label": "t:sections.all.heading_size.options__1.label"
					},
					{
						"value": "h1",
						"label": "t:sections.all.heading_size.options__2.label"
					},
					{
						"value": "h0",
						"label": "t:sections.all.heading_size.options__3.label"
					}
				],
				"default": "h1",
				"label": "t:sections.all.heading_size.label"
			},
			{
				"type": "select",
				"id": "hn",
				"options": [
					{
						"value": "h1",
						"label": "H1"
					},
					{
						"value": "h2",
						"label": "H2"
					},
					{
						"value": "h3",
						"label": "H3"
					},
					{
						"value": "h4",
						"label": "H4"
					},
					{
						"value": "h5",
						"label": "H5"
					},
					{
						"value": "h6",
						"label": "H6"
					}
				],
				"default": "h2",
				"label": "t:sections.all.hn.label",
				"info": "t:sections.all.hn.info"
			},
			{
				"type": "richtext",
				"id": "description",
				"label": "t:sections.faq.settings.description.label",
				"default": {
					"en": "<p>Here are some of the most common questions we get asked. If you can't find what you're looking for, please contact us.</p>",
					"fr": "<p>Voici quelques-unes des questions les plus fréquemment posées. Si vous ne trouvez pas ce que vous cherchez, veuillez nous contacter.</p>"
				}
			},
			{
				"type": "select",
				"id": "text_alignment",
				"label": "t:settings_schema.global.settings.text_alignment.label",
				"options": [
					{
						"value": "left",
						"label": "t:settings_schema.global.settings.text_alignment.options__1.label"
					},
					{
						"value": "center",
						"label": "t:settings_schema.global.settings.text_alignment.options__2.label"
					},
					{
						"value": "right",
						"label": "t:settings_schema.global.settings.text_alignment.options__3.label"
					}
				]
			},
			{
				"type": "header",
				"content": "t:sections.faq.settings.header_section_style.content"
			},
			{
				"type": "checkbox",
				"id": "display_as_card",
				"label": "t:sections.slideshow.settings.display_as_card.label",
				"info": "t:sections.slideshow.settings.display_as_card.info",
				"default": false
			},
			{
				"type": "color_scheme",
				"id": "color_scheme",
				"label": "t:sections.all.colors.label",
				"info": "t:sections.slideshow.settings.color_scheme.info",
				"default": "background-1"
			},
			{
                "type": "header",
                "content": "t:sections.all.padding.section_padding_heading"
            },
			{
				"type": "range",
				"id": "margin_top",
				"min": 0,
				"max": 100,
				"step": 4,
				"unit": "px",
				"label": "t:sections.all.margin.margin_top",
				"default": 0
			},
			{
				"type": "range",
				"id": "margin_bottom",
				"min": 0,
				"max": 100,
				"step": 4,
				"unit": "px",
				"label": "t:sections.all.margin.margin_bottom",
				"default": 0
			},
			{
				"type": "range",
				"id": "padding_top",
				"min": 0,
				"max": 100,
				"step": 4,
				"unit": "px",
				"label": "t:sections.all.padding.padding_top",
				"default": 36
			},
			{
				"type": "range",
				"id": "padding_bottom",
				"min": 0,
				"max": 100,
				"step": 4,
				"unit": "px",
				"label": "t:sections.all.padding.padding_bottom",
				"default": 36
			}
		],
		"blocks": [
			{
				"type": "question",
				"name": "t:sections.faq.blocks.question.name",
				"settings": [
					{
						"type": "text",
						"id": "question",
						"label": "t:sections.faq.blocks.question.settings.question.label",
						"default": {
							"en": "Type your question",
