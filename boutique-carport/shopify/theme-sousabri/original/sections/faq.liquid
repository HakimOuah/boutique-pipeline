					},
					{
						"type": "checkbox",
						"id": "open_by_default",
						"label": "t:sections.main-product.blocks.collapsible.settings.open_by_default.label"
					}
				]
			},
			{
				"type": "content",
				"name": "t:sections.faq.blocks.content.name",
				"settings": [
					{
						"type": "text",
						"id": "heading",
						"label": "t:sections.faq.blocks.content.settings.heading.label",
						"default":	{
							"en": "Frequently Asked Questions",
							"fr": "Foire aux questions"
						}
					},
					{
						"type": "richtext",
						"id": "description",
						"label": "t:sections.faq.blocks.content.settings.description.label",
						"default": {
							"en": "<p>Describe the subject of the following questions</p>",
							"fr": "<p>Décrivez le sujet des questions suivantes</p>"
						}
					},
					{
						"type": "select",
						"id": "heading_size",
						"options": [
							{
								"value": "h2",
								"label": "t:sections.all.heading_size.options__1.label"
							},
							{
								"value": "h1",
								"label": "t:sections.all.heading_size.options__2.label"
							},
							{
								"value": "h0",
								"label": "t:sections.all.heading_size.options__3.label"
							}
						],
						"default": "h1",
						"label": "t:sections.all.heading_size.label"
					},
					{
						"type": "select",
						"id": "hn",
						"options": [
							{
								"value": "h1",
								"label": "H1"
							},
							{
								"value": "h2",
								"label": "H2"
							},
							{
								"value": "h3",
								"label": "H3"
							},
							{
								"value": "h4",
								"label": "H4"
							},
							{
								"value": "h5",
								"label": "H5"
							},
							{
								"value": "h6",
								"label": "H6"
							}
						],
						"default": "h2",
						"label": "t:sections.all.hn.label",
						"info": "t:sections.all.hn.info"
					}
				]
			},
			{
				"type": "divider",
				"name": "t:sections.faq.blocks.divider.name",
				"settings": [
					{
						"type": "range",
						"id": "margin_top",
						"min": 0,
						"max": 100,
						"step": 4,
						"unit": "px",
						"label": "t:sections.all.margin.margin_top",
						"default": 36
					},
					{
						"type": "range",
						"id": "margin_bottom",
						"min": 0,
						"max": 100,
						"step": 4,
						"unit": "px",
						"label": "t:sections.all.margin.margin_bottom",
						"default": 36
					}
				]
			}
		],
		"presets": [
			{
				"name": "t:sections.faq.presets.name",
				"blocks": [
					{
						"type": "question"
					},
					{
						"type": "question"
					},
					{
						"type": "divider"
					},
					{
						"type": "content"
					},
					{
