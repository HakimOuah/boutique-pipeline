{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {}
        },
        "sous-titre": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.custom.sous_titre }}",
            "text_style": "subtitle",
            "text_color": "",
            "enable_icon": false,
            "icon": "heart"
          }
        },
        "price": {
          "type": "price",
          "settings": {
            "show_taxes": false,
            "price_text_box": "",
            "price_text_box_text_color": "#000000",
            "price_text_box_background_color": "#f5f5f5",
            "price_text_box_border_color": "#e0e0e0",
            "regular_price_font_size_desktop": 24,
            "regular_price_font_size_mobile": 20,
            "regular_price_color": "#1B1F24",
            "regular_price_font_weight": "bold",
            "sale_price_font_size_desktop": 24,
            "sale_price_font_size_mobile": 20,
            "sale_price_color": "#C8552B",
            "sale_price_font_weight": "bold",
            "compare_price_font_size_desktop": 24,
            "compare_price_font_size_mobile": 20,
            "compare_price_color": "#999999",
            "compare_price_font_weight": "normal"
          }
        },
        "puces-reassurance": {
          "type": "rich_text",
          "settings": {
            "text": "<ul><li>Livraison offerte en France métropolitaine, sur rendez-vous pour les colis lourds</li><li>Rétractation 14 jours, garantie légale de conformité 2 ans</li><li>Paiement sécurisé (carte, PayPal, Apple Pay, Shop Pay)</li><li>Guide numérique de déclaration et de montage offert</li></ul>"
          }
        },
        "buy-buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_payment_icons": true,
            "show_gift_card_recipient": false,
            "show_price_in_button": false,
            "sticky": true,
            "enable_sticky_atc_desktop": false,
            "sticky_atc_show_image": true,
            "sticky_atc_show_variant": true,
            "sticky_atc_show_quantity": true,
            "sticky_atc_bg_color": "#ffffff",
            "sticky_atc_text_color": "#1B1F24",
            "sticky_atc_button_bg_color": "#C8552B",
            "sticky_atc_button_text_color": "#ffffff"
          }
        },
        "collapsible-specs": {
          "type": "collapsible",
          "settings": {
            "heading": "Dimensions et caractéristiques",
            "content": "{{ product.metafields.custom.specifications }}",
            "description": false,
            "open_by_default": true
          }
        },
        "collapsible-declarer": {
          "type": "collapsible",
          "settings": {
            "heading": "Faut-il le déclarer ?",
            "content": "{{ product.metafields.custom.declarer }}",
            "description": false,
            "open_by_default": false
          }
        },
        "collapsible-montage": {
          "type": "collapsible",
          "settings": {
            "heading": "Montage",
            "content": "{{ product.metafields.custom.montage_texte }}",
            "description": false,
            "open_by_default": false
          }
        },
        "collapsible-ancrage": {
          "type": "collapsible",
          "settings": {
            "heading": "Ancrage et vent",
            "content": "{{ product.metafields.custom.ancrage_vent }}",
            "description": false,
            "open_by_default": false
          }
        },
        "collapsible-ne-fait-pas": {
          "type": "collapsible",
          "settings": {
            "heading": "Ce qu'il ne fait pas",
            "content": "{{ product.metafields.custom.ne_fait_pas }}",
            "description": false,
            "open_by_default": false
          }
        },
        "collapsible-livraison": {
          "type": "collapsible",
          "settings": {
            "heading": "Livraison",
            "content": "{{ product.metafields.custom.livraison_texte }}",
            "description": false,
            "open_by_default": false
          }
        },
        "collapsible-colis": {
          "type": "collapsible",
          "settings": {
            "heading": "Contenu du colis",
            "content": "{{ product.metafields.custom.contenu_colis }}",
            "description": false,
            "open_by_default": false
          }
        }
      },
      "block_order": [
        "title",
        "sous-titre",
        "price",
        "puces-reassurance",
        "buy-buttons",
        "collapsible-specs",
        "collapsible-declarer",
        "collapsible-montage",
        "collapsible-ancrage",
        "collapsible-ne-fait-pas",
        "collapsible-livraison",
        "collapsible-colis"
