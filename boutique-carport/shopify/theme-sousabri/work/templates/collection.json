{
  "sections": {
    "banner": {
      "type": "main-collection-banner",
      "settings": {
        "show_collection_description": true,
        "show_collection_image": false,
        "show_collection_information_below_image": false,
        "hide_collection_image_mobile": false,
        "background": false,
        "border_radius": 0,
        "color_scheme": "background-1",
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "description": {
      "type": "main-collection-description",
      "settings": {
        "color_scheme": "background-1",
        "display_card": false,
        "collapse": false,
        "padding_top": 0,
        "padding_bottom": 12
      }
    },
    "grid": {
      "type": "main-collection-product-grid",
      "settings": {
        "columns_desktop": 3,
        "columns_mobile": "2",
        "color_scheme": "background-1",
        "image_ratio": "adapt",
        "show_secondary_image": false,
        "show_vendor": false,
        "show_rating": false,
        "enable_quick_add": false,
        "product_title_type": "h3",
        "enable_filtering": true,
        "filter_type": "horizontal",
        "filter_radius": 0,
        "filter_shadow": false,
        "filter_mobile_card": false,
        "enable_sorting": true,
        "product_count": true,
        "products_per_page": 16,
        "pagination_type": "pagination",
        "padding_top": 12,
        "padding_bottom": 36
      }
    },
    "texte-seo": {
      "type": "rich-text",
      "blocks": {
        "text": {
          "type": "text",
          "settings": {
            "text": "{{ collection.metafields.custom.texte_seo }}"
          }
        }
      },
      "block_order": [
        "text"
      ],
      "settings": {
        "border_top": true,
        "desktop_content_position": "left",
        "content_alignment": "left",
        "narrow_text": false,
        "display_as_card": false,
        "color_scheme": "background-1",
        "margin_top": 0,
        "margin_bottom": 0,
        "padding_top": 36,
        "padding_bottom": 36
      }
    }
  },
  "order": [
    "banner",
    "description",
    "grid",
    "texte-seo"
  ]
}