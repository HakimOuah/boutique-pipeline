{%- endif -%}\n<style>\n  .nm-cart-upsell{padding-block:var(--gap-md,.75rem);border-top:1px solid rgb(11 11 12 / .08);margin-block-start:var(--gap-sm,.5rem)}\n  .nm-cart-upsell__title{font-family:var(--font-heading--family,inherit);color:#0B0B0C;font-size:1.02rem;margin:0 0 .8rem}\n  .nm-cart-upsell__list{display:flex;flex-direction:column;gap:.9rem}\n  .nm-cart-upsell__item{display:grid;grid-template-columns:56px 1fr;align-items:center;gap:.75rem}\n  .nm-cart-upsell__media{display:block}\n  .nm-cart-upsell__item img{width:56px;height:56px;object-fit:cover;border-radius:10px;background:#E7E4DE;display:block}\n  .nm-cart-upsell__info{display:flex;flex-direction:column;gap:.35rem;min-width:0}\n  .nm-cart-upsell__name{font-size:.85rem;line-height:1.25;color:#0B0B0C;text-decoration:none}\n  .nm-cart-upsell__name:hover{text-decoration:underline}\n  .nm-cart-upsell__row{display:flex;align-items:center;justify-content:space-between;gap:.5rem}\n  .nm-cart-upsell__price{font-size:.9rem;font-weight:600;color:#0B0B0C;white-space:nowrap}\n  .nm-upsell-form{margin:0}\n  .nm-upsell-add{border:0;cursor:pointer;background:#0B0B0C;color:#FAFAF7;font-size:.78rem;font-weight:600;padding:.4rem .85rem;border-radius:999px;white-space:nowrap;transition:background .15s ease}\n  .nm-upsell-add:hover{opacity:.88}\n</style>\n<script>\n  (function () {\n    if (window.__nmUpsellBound) return;\n    window.__nmUpsellBound = true;\n    document.addEventListener('submit', function (e) {\n      var f = e.target && e.target.closest ? e.target.closest('[data-nm-upsell]') : null;\n      if (!f) return;\n      e.preventDefault();\n      var btn = f.querySelector('.nm-upsell-add');\n      if (btn) { btn.disabled = true; btn.textContent = '\\u2026'; }\n      fetch('/cart/add.js', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ id: Number(f.querySelector('[name=id]').value), quantity: 1 })\n      }).then(function (r) {\n        if (!r.ok