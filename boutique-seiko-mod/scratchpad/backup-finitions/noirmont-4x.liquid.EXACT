{%- liquid
  assign nm_variant = closest.product.selected_or_first_available_variant
  assign nm_count = block.settings.installment_count | default: 4
  assign nm_amount = nm_variant.price | divided_by: nm_count
-%}

{%- liquid
  assign nm_min_cents = block.settings.min_price_euros | times: 100
-%}
{%- if nm_variant != blank and nm_variant.price >= nm_min_cents -%}
  <div class="noirmont-4x" {{ block.shopify_attributes }}>
    <span>Ou {{ nm_count }} ×</span>
    <strong>{{ nm_amount | money }}</strong>
    <span>avec</span>
    <span class="noirmont-4x__badge">{{ block.settings.provider_one }}</span>
    {%- if block.settings.provider_two != blank -%}
      <span>ou</span>
      <span class="noirmont-4x__badge noirmont-4x__badge--alt">{{ block.settings.provider_two }}</span>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .noirmont-4x {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    font-size: 0.95rem;
    gap: 6px;
    line-height: 1.4;
  }

  .noirmont-4x strong {
    font-size: 1.02rem;
  }

  .noirmont-4x__badge {
    border: 1px solid rgba(11, 11, 12, 0.16);
    border-radius: 2px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 3px 8px;
  }

  .noirmont-4x__badge--alt {
    background: rgba(169, 142, 95, 0.12);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Paiement fractionné",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "installment_count",
      "label": "Nombre de paiements",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "provider_one",
      "label": "Prestataire 1",
      "default": "PayPal"
    },
    {
      "type": "text",
      "id": "provider_two",
      "label": "Prestataire 2",
      "default": "Klarna"
    },
    {
      "type": "range",
      "id": "min_price_euros",
      "label": "Prix minimum (euros)",
      "min": 0,
      "max": 300,
      "step": 10,
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Paiement fractionné",
      "category": "Produit"
    }
  ]
}
{% endschema %}
