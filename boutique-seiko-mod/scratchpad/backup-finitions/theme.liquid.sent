<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {% render 'material-icons-header' %}

    {% # Charger et précharger le CSS critique %}
    {{ 'reset.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'slider.css' | asset_url | stylesheet_tag: preload: true }}

    {% render 'fonts' %}
    {% render 'scripts' %}
    {% render 'css-variables' %}
    {% render 'color-schemes' %}

    {% # Affinages Noirmont — doit rester après 'css-variables' et 'color-schemes' %}
    {{ 'noirmont-custom.css' | asset_url | stylesheet_tag }}

    {% # Méga-menu illustré — doit rester après 'noirmont-custom.css' %}
    {{ 'noirmont-megamenu.css' | asset_url | stylesheet_tag }}

    {% # Pages collection — doit rester après 'noirmont-custom.css' %}
    {{ 'noirmont-collection.css' | asset_url | stylesheet_tag }}

    {% # Pied de page — doit rester après 'noirmont-custom.css' %}
    {{ 'noirmont-footer.css' | asset_url | stylesheet_tag }}

    {% # Article — tableaux larges défilables. Asset, jamais le champ CSS d'une section : rejeté en silence %}
    {{ 'noirmont-article.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'noirmont-article.js' | asset_url }}" defer></script>

    {{ content_for_header }}

    {% # Correctif « Voir plus » — doit rester la DERNIÈRE feuille du <head> %}
    {{ 'noirmont-see-more-fix.css' | asset_url | stylesheet_tag }}
  </head>

  <body>
    {% render 'toast-notification' %}

    {% if settings.activate_wishlist %}
      {% section 'wishlist-drawer' %}
    {% endif %}

    {% sections 'header-group' %}

    {% if settings.cart_type == 'drawer' %}
      {% sections 'cart-drawer-group' %}
    {% endif %}

    {% sections 'breadcrumbs-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}

    {% render 'material-icons-body' %}
  </body>
</html>